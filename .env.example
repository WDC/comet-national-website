# Required for the quote form (Phase 1) — email via AWS SES
# NB: Vercel/Lambda reserves AWS_* env names, so use SES_* here.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
#
# QUOTE_RECIPIENT_EMAIL accepts a comma-separated list for multiple recipients.
QUOTE_RECIPIENT_EMAIL=david+comet@delcoe.com
# QUOTE_FROM_EMAIL may be a bare address or an RFC 5322 "Name <address>" pair.
# Either way the sender is shown with a display name (never a naked address);
# a bare address gets a per-email default name ("Comet National" / "Comet Quotes").
QUOTE_FROM_EMAIL=Comet National <david+comet@delcoe.com>

# Cloudflare Turnstile (Phase 1)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity (Phase 1 — set after `pnpm sanity init`)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-12-01
SANITY_READ_TOKEN=

# Optional overrides
PUBLIC_SITE_URL=https://www.cometnational.com
