# Required for the quote form (Phase 1)
RESEND_API_KEY=re_xxx
QUOTE_RECIPIENT_EMAIL=sales@cometnational.com
QUOTE_FROM_EMAIL=quotes@cometnational.com

# Cloudflare Turnstile (Phase 1)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity (Phase 1 — set after `pnpm sanity init`)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-12-01
SANITY_READ_TOKEN=

# Optional overrides
PUBLIC_SITE_URL=https://cometnational.com
