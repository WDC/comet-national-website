{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "flatbedltl.com"
        }
      ],
      "destination": "https://cometnational.com/services/flatbed-ltl",
