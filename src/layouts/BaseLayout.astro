---
import BaseHead from "@components/layout/BaseHead.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import StickyMobileCallBar from "@components/layout/StickyMobileCallBar.astro";
import type { PageSeo } from "@lib/seo";

interface Props extends PageSeo {
  preloadHero?: string;
  extraSchema?: Array<Record<string, unknown>>;
  bodyClass?: string;
}
const { bodyClass, ...rest } = Astro.props;

// The sticky mobile call bar's CTA is "Get a Quote" — pointless (and it overlaps
// the form) on the quote page itself, so hide it there. The `has-call-bar` class
// gates the body padding that reserves room for the bar.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const showCallBar = path !== "/get-a-quote";
const bodyClass2 = [bodyClass, showCallBar ? "has-call-bar" : null]
  .filter(Boolean)
  .join(" ") || undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...rest} />
  </head>
  <body class={bodyClass2}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {showCallBar && <StickyMobileCallBar />}

    <script>
      import { bootMotion } from "@lib/motion";
      bootMotion();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        background: var(--c-accent);
        color: var(--c-accent-ink);
        padding: var(--s-2) var(--s-4);
        font-family: var(--ff-display);
        font-weight: 600;
        z-index: 9999;
      }
      .skip-link:focus { top: 0; }
      /* Reserve room above the sticky mobile bar — only on routes that render
         it, and include the notch safe-area so the bar never covers content on
         devices with a home indicator. */
      @media (max-width: 720px) {
        body.has-call-bar { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
      }
    </style>
  </body>
</html>
