---
import BaseHead from "@components/layout/BaseHead.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import StickyMobileCallBar from "@components/layout/StickyMobileCallBar.astro";
import type { PageSeo } from "@lib/seo";

interface Props extends PageSeo {
  preloadHero?: string;
  extraSchema?: Array<Record<string, unknown>>;
  bodyClass?: string;
}
const { bodyClass, ...rest } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...rest} />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCallBar />

    <script>
      import { bootMotion } from "@lib/motion";
      bootMotion();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        background: var(--c-accent);
        color: var(--c-accent-ink);
        padding: var(--s-2) var(--s-4);
        font-family: var(--ff-display);
        font-weight: 600;
        z-index: 9999;
      }
      .skip-link:focus { top: 0; }
      /* Reserve room above sticky mobile bar */
      @media (max-width: 720px) {
        body { padding-bottom: 64px; }
      }
    </style>
  </body>
</html>
