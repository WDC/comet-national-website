---
import BaseLayout from "./BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import ServiceSchema from "@components/seo/ServiceSchema.astro";
import HowItWorksFlow from "@components/animations/HowItWorksFlow.astro";
import { SITE } from "@lib/site";
import { type ServiceItem, type ServiceCategory, getService, getIndustriesForService } from "@lib/services";
import Caps from "@components/ui/Caps.astro";

interface Props {
  service: ServiceItem;
  /** Optional override for the page title pattern. */
  pageTitle?: string;
  pageDescription: string;
  relatedSlugs?: string[];
}
const { service, pageTitle, pageDescription, relatedSlugs } = Astro.props;
const title = pageTitle ?? `${service.title} | ${SITE.name}`;
const url = `${SITE.url}/services/${service.slug}`;

// Industries that actually buy this service — closes the internal-link loop
// (industry pages already link out to services).
const industries = getIndustriesForService(service.slug);

// Vary the closing CTA by service family so all 12 pages don't end on the exact
// same "Tell us about the load" block.
const CLOSERS: Record<ServiceCategory, { title: string; body: string }> = {
  trailer: {
    title: "Tell us about the load.",
    body: "Dimensions, weight, where it’s going, and when it has to be there. We’ll put the right trailer under it.",
  },
  facility: {
    title: "Tell us what the dock needs to do.",
    body: "Transload, cross-dock, recover, or store — describe the freight and the deadline, and we’ll handle it from our dock.",
  },
  managed: {
    title: "Tell us about the problem.",
    body: "One call, every mode. Describe the freight and we’ll figure out how it moves — and move it.",
  },
};
const closer = CLOSERS[service.category];
---
<BaseLayout
  title={title}
  description={pageDescription}
  ogType="website"
>
  <ServiceSchema
    service={{
      name: service.title,
      url,
      description: pageDescription,
      serviceType: service.schemaServiceType,
    }}
    faq={service.faqs}
  />

  <article class="pillar">
    <header class="pillar__hero section-tight section-bar" data-reveal>
      <div class="container-content pillar__hero-inner">
        <nav aria-label="Breadcrumb" class="pillar__crumbs mono">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">/</span>
          <span>{service.title}</span>
        </nav>

        <div class="pillar__hero-grid">
          <div class="reveal-stagger" data-reveal>
            <p class="eyebrow">Service · {service.category === "trailer" ? "By trailer" : service.category === "facility" ? "By facility" : "Managed"}</p>
            <h1 class="pillar__headline display"><Caps text={service.title} /></h1>
            {service.equityLine && (
              <p class="pillar__equity display"><Caps text={service.equityLine} /></p>
            )}
            <p class="pillar__blurb"><Caps text={service.blurb} /></p>
            <div class="pillar__cta">
              <Button href="/get-a-quote" size="lg">Get a Quote</Button>
              <a class="pillar__phone mono" href={`tel:${SITE.phoneE164}`}>or call {SITE.phone}</a>
            </div>
          </div>
          <aside class="pillar__art reveal" data-reveal style="--reveal-delay: 200ms">
            <slot name="hero-art" />
          </aside>
        </div>
      </div>
    </header>

    <div class="container-content pillar__body">
      <slot />

      <section class="pillar__how">
        <p class="eyebrow">How it works</p>
        <h2 class="pillar__h2 display">Quote. Schedule. Rest easy.</h2>
        <HowItWorksFlow />
      </section>

      {service.faqs && service.faqs.length > 0 && (
        <section class="pillar__faq" data-reveal>
          <p class="eyebrow">Common questions</p>
          <h2 class="pillar__h2 display">Before you call, in case it helps.</h2>
          <ul class="pillar__faq-list reveal-stagger" data-reveal>
            {service.faqs.map((f) => (
              <li>
                <details class="pillar__faq-item">
                  <summary class="pillar__faq-q">
                    <span>{f.q}</span>
                    <span class="pillar__faq-mark" aria-hidden="true"></span>
                  </summary>
                  <p class="pillar__faq-a">{f.a}</p>
                </details>
              </li>
            ))}
          </ul>
        </section>
      )}

      {relatedSlugs && relatedSlugs.length > 0 && (
        <section class="pillar__related" data-reveal>
          <p class="eyebrow">Related services</p>
          <ul class="pillar__related-list reveal-stagger" data-reveal>
            {relatedSlugs.map((slug) => {
              const s = getService(slug);
              if (!s) return null;
              return (
                <li>
                  <a href={`/services/${s.slug}`} class="link-arrow">
                    <span class="pillar__related-title display"><Caps text={s.title} /></span>
                    <span class="pillar__related-blurb"><Caps text={s.blurb} /></span>
                    <span class="pillar__related-cta arrow">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {industries.length > 0 && (
        <section class="pillar__industries" data-reveal>
          <p class="eyebrow">Common industries</p>
          <h2 class="pillar__h2 display">Who moves freight this way.</h2>
          <ul class="pillar__industries-list reveal-stagger" data-reveal>
            {industries.map((ind) => (
              <li>
                <a href={`/industries/${ind.slug}`} class="link-arrow">
                  <span class="pillar__industries-title display"><Caps text={ind.title} /></span>
                  <span class="pillar__industries-cta arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="pillar__final-cta section-tight reveal" data-reveal>
        <h2 class="pillar__h2 display">{closer.title}</h2>
        <p class="pillar__final-body">{closer.body}</p>
        <Button href="/get-a-quote" size="lg">Get a Quote</Button>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .pillar__hero {
    background: var(--c-bg-elevated);
    border-bottom: 1px solid var(--c-line);
  }
  .pillar__crumbs {
    display: flex;
    gap: var(--s-2);
    font-size: var(--t-eyebrow);
    color: var(--c-ink-muted);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    margin-bottom: var(--s-8);
  }
  .pillar__crumbs a {
    color: inherit;
    transition: color var(--d-fast) var(--ease-out), letter-spacing var(--d-base) var(--ease-out);
  }
  .pillar__crumbs a:hover { color: var(--c-accent-deep); letter-spacing: 0.18em; }
  .pillar__hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s-10);
    align-items: center;
  }
  .pillar__headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    margin-top: var(--s-3);
    max-width: 14ch;
  }
  .pillar__equity {
    margin-top: var(--s-5);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.2;
    color: var(--c-accent-deep);
    font-weight: 600;
    max-width: 26ch;
  }
  .pillar__blurb {
    margin-top: var(--s-5);
    color: var(--c-ink-muted);
    max-width: 50ch;
    font-size: var(--t-body-sm);
    line-height: 1.55;
  }
  .pillar__cta {
    margin-top: var(--s-8);
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .pillar__phone {
    color: var(--c-ink-muted);
  }

  .pillar__art {
    background: var(--c-bg);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    transition: border-color var(--d-base) var(--ease-out), box-shadow var(--d-base) var(--ease-out);
  }
  .pillar__art:hover {
    border-color: var(--c-accent);
    box-shadow: 0 12px 28px -20px color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  .pillar__body {
    padding-block: var(--s-16);
    display: grid;
    gap: var(--s-20);
  }
  .pillar__h2 {
    font-size: var(--t-h1);
    line-height: 1;
    margin-top: var(--s-3);
    margin-bottom: var(--s-8);
  }

  .pillar__related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .pillar__related-list li {
    background: var(--c-bg);
    position: relative;
    overflow: hidden;
    transition: transform var(--d-base) var(--ease-out);
  }
  .pillar__related-list li::before {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-base) var(--ease-out);
  }
  .pillar__related-list li:hover::before { transform: scaleX(1); }
  .pillar__related-list a {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6);
    color: var(--c-ink);
    min-height: 160px;
    transition: background var(--d-fast) var(--ease-out);
  }
  .pillar__related-list a:hover { background: var(--c-bg-elevated); }
  .pillar__related-title { font-size: 1.25rem; line-height: 1.1; }
  .pillar__related-blurb { font-size: var(--t-small); color: var(--c-ink-muted); }
  .pillar__related-cta {
    color: var(--c-accent-deep);
    font-family: var(--ff-display);
    font-weight: 600;
  }

  /* Common industries — compact chip row of the buyers who use this service. */
  .pillar__industries-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .pillar__industries-list a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--c-line);
    background: var(--c-bg-elevated);
    color: var(--c-ink);
    transition:
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out);
  }
  .pillar__industries-list a:hover {
    border-color: var(--c-accent);
    background: var(--c-bg);
    transform: translateY(-1px);
  }
  .pillar__industries-title { font-size: var(--t-body-sm); line-height: 1; }
  .pillar__industries-cta { color: var(--c-accent-deep); font-weight: 700; }

  .pillar__faq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--c-line);
  }
  .pillar__faq-item {
    border-bottom: 1px solid var(--c-line);
  }
  .pillar__faq-q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: var(--ls-snug);
    color: var(--c-ink);
    transition: color var(--d-fast) var(--ease-out);
  }
  .pillar__faq-q::-webkit-details-marker { display: none; }
  .pillar__faq-q:hover { color: var(--c-accent-deep); }
  /* Plus/minus mark drawn from borders so it needs no icon font. */
  .pillar__faq-mark {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 4px;
  }
  .pillar__faq-mark::before,
  .pillar__faq-mark::after {
    content: "";
    position: absolute;
    background: var(--c-accent-deep);
    transition: transform var(--d-fast) var(--ease-out), opacity var(--d-fast) var(--ease-out);
  }
  .pillar__faq-mark::before { inset: 6px 0; height: 2px; }
  .pillar__faq-mark::after { inset: 0 6px; width: 2px; }
  .pillar__faq-item[open] .pillar__faq-mark::after { transform: scaleY(0); opacity: 0; }
  .pillar__faq-item[open] .pillar__faq-q { color: var(--c-accent-deep); }
  .pillar__faq-a {
    margin: 0;
    padding: 0 var(--s-8) var(--s-6) 0;
    color: var(--c-ink-muted);
    max-width: 68ch;
    font-size: var(--t-body-sm);
    line-height: var(--lh-relaxed);
  }

  .pillar__final-cta {
    text-align: center;
    background: var(--c-pine-deep);
    color: var(--c-bg);
    padding: var(--s-16);
    border-radius: var(--r-md);
  }
  .pillar__final-cta .pillar__h2 { color: var(--c-bg); }
  .pillar__final-body {
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: var(--s-6);
    max-width: 50ch;
    margin-inline: auto;
  }

  @media (max-width: 880px) {
    .pillar__hero-grid { grid-template-columns: 1fr; }
  }
  /* Related services: 3 → 2 → 1 so the tablet range keeps a two-up grid. */
  @media (max-width: 960px) {
    .pillar__related-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .pillar__related-list { grid-template-columns: 1fr; }
  }
</style>
