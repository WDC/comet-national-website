---
import BaseLayout from "./BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import ServiceSchema from "@components/seo/ServiceSchema.astro";
import HowItWorksFlow from "@components/animations/HowItWorksFlow.astro";
import { SITE } from "@lib/site";
import { type ServiceItem, getService } from "@lib/services";
import Caps from "@components/ui/Caps.astro";

interface Props {
  service: ServiceItem;
  /** Optional override for the page title pattern. */
  pageTitle?: string;
  pageDescription: string;
  relatedSlugs?: string[];
}
const { service, pageTitle, pageDescription, relatedSlugs } = Astro.props;
const title = pageTitle ?? `${service.title} | ${SITE.name}`;
const url = `${SITE.url}/services/${service.slug}`;
---
<BaseLayout
  title={title}
  description={pageDescription}
  ogType="website"
>
  <ServiceSchema
    service={{
      name: service.title,
      url,
      description: pageDescription,
      serviceType: service.schemaServiceType,
    }}
  />

  <article class="pillar">
    <header class="pillar__hero section-tight section-bar" data-reveal>
      <div class="container-content pillar__hero-inner">
        <nav aria-label="Breadcrumb" class="pillar__crumbs mono">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">/</span>
          <span>{service.title}</span>
        </nav>

        <div class="pillar__hero-grid">
          <div class="reveal-stagger" data-reveal>
            <p class="eyebrow">Service · {service.category === "trailer" ? "By trailer" : service.category === "facility" ? "By facility" : "Managed"}</p>
            <h1 class="pillar__headline display"><Caps text={service.title} /></h1>
            {service.equityLine && (
              <p class="pillar__equity display"><Caps text={service.equityLine} /></p>
            )}
            <p class="pillar__blurb"><Caps text={service.blurb} /></p>
            <div class="pillar__cta">
              <Button href="/get-a-quote" size="lg">Get a Quote</Button>
              <a class="pillar__phone mono" href={`tel:${SITE.phoneE164}`}>or call {SITE.phone}</a>
            </div>
          </div>
          <aside class="pillar__art reveal" data-reveal style="--reveal-delay: 200ms">
            <slot name="hero-art" />
          </aside>
        </div>
      </div>
    </header>

    <div class="container-content pillar__body">
      <slot />

      <section class="pillar__how">
        <p class="eyebrow">How it works</p>
        <h2 class="pillar__h2 display">Quote. Schedule. Rest easy.</h2>
        <HowItWorksFlow />
      </section>

      {relatedSlugs && relatedSlugs.length > 0 && (
        <section class="pillar__related" data-reveal>
          <p class="eyebrow">Related services</p>
          <ul class="pillar__related-list reveal-stagger" data-reveal>
            {relatedSlugs.map((slug) => {
              const s = getService(slug);
              if (!s) return null;
              return (
                <li>
                  <a href={`/services/${s.slug}`} class="link-arrow">
                    <span class="pillar__related-title display"><Caps text={s.title} /></span>
                    <span class="pillar__related-blurb"><Caps text={s.blurb} /></span>
                    <span class="pillar__related-cta arrow">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <section class="pillar__final-cta section-tight reveal" data-reveal>
        <h2 class="pillar__h2 display">Tell us about the load.</h2>
        <p class="pillar__final-body">
          The quote form takes a minute. The right answer often takes less.
        </p>
        <Button href="/get-a-quote" size="lg">Get a Quote</Button>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .pillar__hero {
    background: var(--c-bg-elevated);
    border-bottom: 1px solid var(--c-line);
  }
  .pillar__crumbs {
    display: flex;
    gap: var(--s-2);
    font-size: var(--t-eyebrow);
    color: var(--c-ink-muted);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    margin-bottom: var(--s-8);
  }
  .pillar__crumbs a {
    color: inherit;
    transition: color var(--d-fast) var(--ease-out), letter-spacing var(--d-base) var(--ease-out);
  }
  .pillar__crumbs a:hover { color: var(--c-accent); letter-spacing: 0.18em; }
  .pillar__hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s-10);
    align-items: center;
  }
  .pillar__headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    margin-top: var(--s-3);
    max-width: 14ch;
  }
  .pillar__equity {
    margin-top: var(--s-5);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.2;
    color: var(--c-accent);
    font-weight: 600;
    max-width: 26ch;
  }
  .pillar__blurb {
    margin-top: var(--s-5);
    color: var(--c-ink-muted);
    max-width: 50ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .pillar__cta {
    margin-top: var(--s-8);
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .pillar__phone {
    color: var(--c-ink-muted);
  }

  .pillar__art {
    background: var(--c-bg);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    transition: border-color var(--d-base) var(--ease-out), box-shadow var(--d-base) var(--ease-out);
  }
  .pillar__art:hover {
    border-color: var(--c-accent);
    box-shadow: 0 12px 28px -20px rgba(245, 166, 35, 0.4);
  }

  .pillar__body {
    padding-block: var(--s-16);
    display: grid;
    gap: var(--s-20);
  }
  .pillar__h2 {
    font-size: var(--t-h1);
    line-height: 1;
    margin-top: var(--s-3);
    margin-bottom: var(--s-8);
  }

  .pillar__related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .pillar__related-list li {
    background: var(--c-bg);
    position: relative;
    overflow: hidden;
    transition: transform var(--d-base) var(--ease-out);
  }
  .pillar__related-list li::before {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-base) var(--ease-out);
  }
  .pillar__related-list li:hover::before { transform: scaleX(1); }
  .pillar__related-list a {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6);
    color: var(--c-ink);
    min-height: 160px;
    transition: background var(--d-fast) var(--ease-out);
  }
  .pillar__related-list a:hover { background: var(--c-bg-elevated); }
  .pillar__related-title { font-size: 1.25rem; line-height: 1.1; }
  .pillar__related-blurb { font-size: var(--t-small); color: var(--c-ink-muted); }
  .pillar__related-cta {
    color: var(--c-accent);
    font-family: var(--ff-display);
    font-weight: 600;
  }

  .pillar__final-cta {
    text-align: center;
    background: var(--c-pine-deep);
    color: var(--c-bg);
    padding: var(--s-16);
    border-radius: var(--r-md);
  }
  .pillar__final-cta .pillar__h2 { color: var(--c-bg); }
  .pillar__final-body {
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: var(--s-6);
    max-width: 50ch;
    margin-inline: auto;
  }

  @media (max-width: 880px) {
    .pillar__hero-grid { grid-template-columns: 1fr; }
    .pillar__related-list { grid-template-columns: 1fr; }
  }
</style>
