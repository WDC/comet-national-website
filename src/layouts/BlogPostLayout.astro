---
import BaseLayout from "./BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import Caps from "@components/ui/Caps.astro";
import { SITE } from "@lib/site";
import { articleSchema } from "@lib/schema";
import {
  type Post,
  postPath,
  postUrl,
  postOgImage,
  formatDate,
  isoDate,
  readingMinutes,
  getPublishedPosts,
} from "@lib/posts";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { data } = post;

const url = postUrl(post);
const minutes = readingMinutes(post);
const eyebrow = data.category ?? "Blog";

// Related: prefer posts that share a tag, then fall back to the newest others.
const all = await getPublishedPosts();
const others = all.filter((p) => p.id !== post.id);
const tagged = others.filter((p) => p.data.tags.some((t) => data.tags.includes(t)));
const related = [...tagged, ...others.filter((p) => !tagged.includes(p))].slice(0, 3);

const schema = articleSchema({
  title: data.title,
  url,
  description: data.summary,
  datePublished: isoDate(data.publishedDate),
  dateModified: data.updatedDate ? isoDate(data.updatedDate) : undefined,
  authorName: data.author,
  image: postOgImage(post),
});
---
<BaseLayout
  title={data.title}
  description={data.summary}
  ogType="article"
  ogImage={postOgImage(post)}
  article={{
    publishedTime: isoDate(data.publishedDate),
    modifiedTime: data.updatedDate ? isoDate(data.updatedDate) : undefined,
    author: data.author,
    tags: data.tags,
  }}
  breadcrumbTitle={data.title}
  extraSchema={[schema]}
>
  <article class="post">
    <header class="post__hero section-tight" data-reveal>
      <div class="container-content post__hero-inner">
        <nav aria-label="Breadcrumb" class="post__crumbs mono">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{data.title}</span>
        </nav>

        <p class="eyebrow post__eyebrow">{eyebrow}</p>
        <h1 class="post__title display"><Caps text={data.title} /></h1>
        <p class="post__summary"><Caps text={data.summary} /></p>

        <div class="post__meta mono">
          <span>{data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(data.publishedDate)}>{formatDate(data.publishedDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(data.updatedDate)}</span>
            </>
          )}
        </div>

        {data.tags.length > 0 && (
          <ul class="post__tags" aria-label="Topics">
            {data.tags.map((t) => (
              <li class="post__tag mono"><Caps text={t} /></li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="container-content post__body-wrap">
      <div class="prose post-body" data-reveal>
        <slot />
      </div>

      <aside class="post__cta section-tight" data-reveal>
        <p class="eyebrow">Have a load like this?</p>
        <h2 class="post__cta-title display">Tell us about the freight.</h2>
        <p class="post__cta-body">
          One call reaches a real dispatcher in Atlanta. We will quote it, route it, and own it end to end.
        </p>
        <div class="post__cta-actions">
          <Button href="/get-a-quote" size="lg">Get a Quote</Button>
          <a class="post__cta-phone mono" href={`tel:${SITE.phoneE164}`}>or call {SITE.phone}</a>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="post__related container-content" data-reveal>
        <p class="eyebrow">Keep reading</p>
        <ul class="post__related-list reveal-stagger" data-reveal>
          {related.map((p) => (
            <li>
              <a href={postPath(p)} class="post__related-item">
                <span class="post__related-eyebrow mono">{p.data.category ?? "Blog"}</span>
                <span class="post__related-title display"><Caps text={p.data.title} /></span>
                <span class="post__related-date mono">{formatDate(p.data.publishedDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .post__hero {
    background: var(--c-bg-elevated);
    border-bottom: 1px solid var(--c-line);
  }
  .post__hero-inner {
    max-width: 60rem;
  }
  .post__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--t-eyebrow);
    color: var(--c-ink-muted);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    margin-bottom: var(--s-8);
  }
  .post__crumbs a {
    transition: color var(--d-fast) var(--ease-out);
  }
  .post__crumbs a:hover { color: var(--c-accent); }
  .post__crumbs span:last-child {
    color: var(--c-ink-soft);
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post__eyebrow {
    color: var(--c-accent-deep);
  }
  .post__title {
    margin-top: var(--s-3);
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    line-height: 1.02;
    max-width: 20ch;
  }
  .post__summary {
    margin-top: var(--s-5);
    font-family: var(--ff-body);
    font-size: var(--t-lede);
    line-height: var(--lh-snug);
    color: var(--c-ink-muted);
    max-width: 54ch;
  }
  .post__meta {
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-small);
    color: var(--c-ink-soft);
    font-feature-settings: "lnum" 1, "tnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .post__tags {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .post__tag {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-ink-muted);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    padding: 4px 10px;
  }

  .post__body-wrap {
    display: grid;
    justify-items: center;
    padding-block: var(--s-16);
    gap: var(--s-16);
  }
  .post__body-wrap .prose {
    width: 100%;
    max-width: 68ch;
  }

  .post__cta {
    width: 100%;
    max-width: 68ch;
    background: var(--c-pine-deep);
    color: var(--c-bg);
    padding: var(--s-10);
    border-radius: var(--r-md);
    text-align: left;
  }
  .post__cta .eyebrow { color: var(--c-accent); }
  .post__cta-title {
    margin-top: var(--s-3);
    font-size: var(--t-h2);
    line-height: 1.05;
    color: var(--c-bg);
  }
  .post__cta-body {
    margin-top: var(--s-4);
    color: rgba(247, 246, 238, 0.74);
    max-width: 48ch;
  }
  .post__cta-actions {
    margin-top: var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .post__cta-phone { color: rgba(247, 246, 238, 0.78); }
  .post__cta-phone:hover { color: var(--c-accent); }

  .post__related {
    padding-bottom: var(--s-16);
  }
  .post__related-list {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .post__related-item {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    background: var(--c-bg);
    padding: var(--s-6);
    min-height: 150px;
    transition: background var(--d-fast) var(--ease-out);
  }
  .post__related-item:hover { background: var(--c-bg-elevated); }
  .post__related-eyebrow {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--c-accent-deep);
  }
  .post__related-title {
    font-size: 1.2rem;
    line-height: 1.12;
    color: var(--c-ink);
  }
  .post__related-date {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  @media (max-width: 720px) {
    .post__related-list { grid-template-columns: 1fr; }
  }
</style>
