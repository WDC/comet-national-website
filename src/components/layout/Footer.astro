---
import Logo from "./Logo.astro";
import Caps from "@components/ui/Caps.astro";
import { SITE } from "@lib/site";
import { SERVICES_BY_CATEGORY } from "@lib/services";

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-content site-footer__grid reveal-stagger" data-reveal>
    <div class="site-footer__brand">
      <Logo variant="bg" />
      <p class="site-footer__tag">{SITE.trustLine}</p>
      <address class="site-footer__nap">
        <div>{SITE.address.street}</div>
        <div>{SITE.address.locality}, {SITE.address.region} {SITE.address.postal}</div>
        <div>
          <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a>
        </div>
        <div>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </address>
    </div>

    <nav class="site-footer__col" aria-label="Footer — By trailer">
      <div class="eyebrow site-footer__heading">By trailer</div>
      <ul>
        {SERVICES_BY_CATEGORY.trailer.map((s) => (
          <li><a href={`/services/${s.slug}`}><Caps text={s.title} /></a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Footer — By facility and managed">
      <div class="eyebrow site-footer__heading">Facility &amp; managed</div>
      <ul>
        {SERVICES_BY_CATEGORY.facility.map((s) => (
          <li><a href={`/services/${s.slug}`}><Caps text={s.title} /></a></li>
        ))}
        {SERVICES_BY_CATEGORY.managed.map((s) => (
          <li><a href={`/services/${s.slug}`}><Caps text={s.title} /></a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Footer — Company">
      <div class="eyebrow site-footer__heading">Company</div>
      <ul>
        <li><a href="/why-comet">Why Comet</a></li>
        <li><a href="/industries">Industries</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/locations/atlanta">Atlanta facility</a></li>
        <li><a href="/carriers">Carriers</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>

  <!-- PLACEHOLDER — regulatory authority + insurance.
       Freight/brokerage trust signals REQUIRED before launch. The client must
       supply the real MC #, USDOT #, and cargo/liability insurance statement.
       The loud styling is intentional so it can't be missed in review. -->
  <div class="container-content">
    <div class="site-footer__authority" role="note" data-placeholder>
      <span class="site-footer__authority-tag">PLACEHOLDER</span>
      <p class="site-footer__authority-copy">
        MC #&nbsp;______ · USDOT #&nbsp;______ · Cargo &amp; auto-liability insurance statement.
        <strong>Client to provide these authority numbers before launch.</strong>
      </p>
    </div>
  </div>

  <div class="container-content site-footer__base">
    <div class="site-footer__legal mono">
      © {year} {SITE.legalName}. All rights reserved.
    </div>
    <nav class="site-footer__legal-links" aria-label="Footer — Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Use</a>
    </nav>
    <div class="site-footer__socials">
      {SITE.socials.map((s) => (
        <a href={s.url} rel="noopener" target="_blank">{s.platform}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-pine-deep);
    color: var(--c-bg);
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: var(--s-8);
    margin-top: var(--s-16);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--s-10);
    padding-bottom: var(--s-12);
    border-bottom: 1px solid var(--c-line-inverse);
  }
  .site-footer__tag {
    margin-top: var(--s-3);
    font-family: var(--ff-display);
    font-size: 1.1rem;
    line-height: 1.3;
    max-width: 24ch;
    color: rgba(247, 246, 238, 0.78);
  }
  .site-footer__nap {
    margin-top: var(--s-5);
    font-style: normal;
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    line-height: 1.7;
    color: rgba(247, 246, 238, 0.7);
    /* address, zip, phone — lining figures on a fixed advance */
    font-feature-settings: "lnum" 1, "tnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .site-footer__nap a:hover { color: var(--c-accent); }

  .site-footer__heading {
    color: var(--c-accent);
    margin-bottom: var(--s-3);
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }
  .site-footer__col a {
    display: inline-block;
    padding-block: 4px; /* ≥24px tap target (WCAG 2.5.8) without changing rhythm */
    font-size: var(--t-small);
    color: rgba(247, 246, 238, 0.78);
  }
  .site-footer__col a:hover { color: var(--c-accent); }

  /* PLACEHOLDER authority block — deliberately loud so the client can't ship
     without supplying real MC/USDOT numbers and an insurance statement. */
  .site-footer__authority {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-8);
    padding: var(--s-4) var(--s-5);
    background: #ff0000;
    border: 3px dashed #ffff00;
    color: #ffffff;
    border-radius: var(--r-sm);
  }
  .site-footer__authority-tag {
    flex: none;
    font-family: var(--ff-mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    background: #ffff00;
    color: #000000;
    padding: 4px 10px;
  }
  .site-footer__authority-copy {
    margin: 0;
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    line-height: 1.5;
    color: #ffffff;
  }
  .site-footer__authority-copy strong { color: #ffff00; }

  .site-footer__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-top: var(--s-6);
    font-size: var(--t-small);
    color: rgba(247, 246, 238, 0.55);
  }
  .site-footer__legal-links {
    display: flex;
    gap: var(--s-5);
    order: 3;
    flex-basis: 100%;
  }
  .site-footer__legal-links a,
  .site-footer__socials a {
    display: inline-block;
    padding-block: 4px;
  }
  .site-footer__legal-links a { color: rgba(247, 246, 238, 0.7); }
  .site-footer__legal-links a:hover { color: var(--c-accent); }
  .site-footer__socials a {
    color: rgba(247, 246, 238, 0.78);
    margin-left: var(--s-4);
  }
  .site-footer__socials a:hover { color: var(--c-accent); }

  @media (max-width: 880px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
    .site-footer__base {
      flex-direction: column;
      gap: var(--s-2);
      align-items: flex-start;
    }
  }
</style>
