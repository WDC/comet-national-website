---
import { resolveSeo, type PageSeo } from "@lib/seo";
import { organizationSchema, websiteSchema, breadcrumbSchema, breadcrumbsFromPath, crumbTitles } from "@lib/schema";
import { ogImageForPath } from "@lib/og/pages";
import { SITE } from "@lib/site";
import JsonLd from "@components/seo/JsonLd.astro";
import "@styles/base.css";
import "@styles/motion.css";

interface Props extends PageSeo {
  preloadHero?: string;
  extraSchema?: Array<Record<string, unknown>>;
}

const { preloadHero, extraSchema = [], ...seoInput } = Astro.props;
// Per-page OG card (/og/<key>.png) when this route has one, unless the page set
// its own ogImage explicitly (e.g. blog posts). Falls back to the site default.
const seo = resolveSeo({
  ...seoInput,
  ogImage: seoInput.ogImage ?? ogImageForPath(Astro.url.pathname),
  pathname: Astro.url.pathname,
});

const showBreadcrumbs = Astro.url.pathname.split("/").filter(Boolean).length >= 1;
const sitewideSchemas: Array<Record<string, unknown>> = [
  organizationSchema(),
  websiteSchema(),
];
if (showBreadcrumbs) {
  sitewideSchemas.push(breadcrumbSchema({ items: breadcrumbsFromPath(Astro.url.pathname, crumbTitles()) }));
}
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#2f462b" />
<meta name="format-detection" content="telephone=yes" />
<meta name="generator" content={Astro.generator} />

<!-- Set the JS flag before first paint so `.reveal` hidden states only apply
     when JavaScript can un-hide them. No-JS users (and non-executing crawlers)
     see fully rendered content instead of blank scroll-reveal slabs. -->
<script is:inline>document.documentElement.classList.add("js");</script>

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<meta name="robots" content={seo.robots} />

<!-- Open Graph -->
<meta property="og:type" content={seo.ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.title} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={seo.title} />

<!-- Preload the three critical above-the-fold MB faces (body serif, hero display,
     mono labels). font-display:swap + metric-matched fallbacks cover the rest. -->
<link rel="preload" href="/fonts/equity_ot_a_regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/concourse_ot_8_black.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/triplicate_ot_a_regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- DNS prefetch for Sanity CDN (Phase 2+) -->
<link rel="dns-prefetch" href="https://cdn.sanity.io" />

{preloadHero && <link rel="preload" as="image" href={preloadHero} fetchpriority="high" />}

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href="/blog/rss.xml" />

<!-- Sitewide JSON-LD -->
{sitewideSchemas.map((d) => <JsonLd data={d} />)}
{extraSchema.map((d) => <JsonLd data={d} />)}
