---
import { SITE } from "@lib/site";
---
<div class="sticky-call-bar" role="region" aria-label="Quick contact">
  <a class="sticky-call-bar__call" href={`tel:${SITE.phoneE164}`} aria-label={`Call ${SITE.phone}`}>
    <svg class="phone-icon" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M3.654 1.328a.678.678 0 00-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 004.168 6.608 17.6 17.6 0 006.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 00-.063-1.015l-2.307-1.794a.678.678 0 00-.58-.122l-2.19.547a1.745 1.745 0 01-1.657-.459L5.482 8.157a1.745 1.745 0 01-.46-1.657l.548-2.19a.678.678 0 00-.122-.58L3.654 1.328z" fill="currentColor"/>
    </svg>
    Call us
  </a>
  <a class="sticky-call-bar__quote" href="/get-a-quote">Get a Quote <span class="arrow" aria-hidden="true">→</span></a>
</div>

<style>
  .sticky-call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: none;
    grid-template-columns: 1fr 1fr;
    z-index: var(--z-sticky);
    background: var(--c-navy-deep);
    color: var(--c-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -8px 20px -16px rgba(0, 0, 0, 0.4);
  }
  .sticky-call-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-3);
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: var(--ls-snug);
  }
  .sticky-call-bar__call { color: var(--c-bg); }
  .sticky-call-bar__quote {
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }
  @media (max-width: 720px) {
    .sticky-call-bar {
      display: grid;
      padding-bottom: env(safe-area-inset-bottom);
      animation: bar-slide-up 400ms var(--ease-out) 200ms backwards;
    }
  }
  @keyframes bar-slide-up {
    from { transform: translateY(100%); }
    to   { transform: translateY(0); }
  }
  .sticky-call-bar a {
    transition: background var(--d-fast) var(--ease-out), color var(--d-fast) var(--ease-out);
  }
  .sticky-call-bar__quote:hover { background: var(--c-accent-hover); }
  .sticky-call-bar__call:active,
  .sticky-call-bar__quote:active { filter: brightness(0.95); }
</style>
