---
/**
 * Full-width "slab" panel for one top-level nav section. Data-driven from
 * src/lib/nav.ts so Services, Industries, and Company all get the same
 * treatment. Rendered inside the desktop navbar; the mobile drawer renders
 * the same NavSection data as expanding slabs (see Header.astro).
 */
import type { NavSection } from "@lib/nav";
import Caps from "@components/ui/Caps.astro";

interface Props {
  section: NavSection;
}
const { section } = Astro.props;

// Single-group sections (Industries, Company) spread their items across two
// columns so the slab keeps the same landscape shape as the Services panel.
const wide = section.groups.length === 1;
const columns = wide ? 2 : section.groups.length;
---
<!-- A disclosure of plain navigation links — deliberately NOT role="menu",
     which would promise arrow-key navigation this pattern doesn't implement. -->
<div
  id={`${section.id}-mega-menu`}
  class="mega-menu"
  aria-labelledby={`${section.id}-trigger`}
  style={`--slab-cols: ${columns}`}
>
  <div class="mega-menu__inner container-content">
    {section.groups.map((g) => (
      <div class={`mega-menu__group${wide ? " mega-menu__group--wide" : ""}`}>
        <div class="eyebrow mega-menu__group-label">{g.label}</div>
        <ul class="mega-menu__list">
          {g.items.map((item) => (
            <li>
              <a href={item.href} class="mega-menu__item">
                <span class="mega-menu__item-title"><Caps text={item.title} /></span>
                {item.blurb && (
                  <span class="mega-menu__item-blurb"><Caps text={item.blurb} /></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="mega-menu__cta on-dark">
      <div class="eyebrow">{section.cta.eyebrow}</div>
      <p class="mega-menu__cta-line">{section.cta.line}</p>
      <a href={section.cta.href} class="mega-menu__cta-link">{section.cta.label} →</a>
    </div>
    <div class="mega-menu__footer">
      <a href={section.href} class="mega-menu__overview">
        {section.overviewLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .mega-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--c-bg-elevated);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 18px 32px -24px rgba(22, 29, 18, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out),
      visibility var(--d-fast) linear;
    z-index: var(--z-nav);
  }
  .mega-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .mega-menu__inner {
    display: grid;
    grid-template-columns: repeat(var(--slab-cols, 3), 1fr) 0.85fr;
    gap: var(--s-8) var(--s-10);
    padding-block: var(--s-10) var(--s-6);
  }
  .mega-menu__group--wide {
    grid-column: span var(--slab-cols, 2);
  }
  .mega-menu__group--wide .mega-menu__list {
    grid-template-columns: repeat(var(--slab-cols, 2), 1fr);
    column-gap: var(--s-10);
  }
  .mega-menu__group-label {
    margin-bottom: var(--s-4);
  }
  .mega-menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-1);
  }
  .mega-menu__item {
    display: grid;
    gap: 2px;
    padding: var(--s-2) var(--s-2) var(--s-2) 0;
    border-left: 2px solid transparent;
    padding-left: var(--s-3);
    margin-left: calc(-1 * var(--s-3));
    border-radius: var(--r-sm);
    transition: border-color var(--d-fast) var(--ease-out), background var(--d-fast) var(--ease-out);
  }
  .mega-menu__item:hover,
  .mega-menu__item:focus-visible {
    border-left-color: var(--c-accent);
    background: var(--c-bg);
    /* Keep the global :focus-visible outline — the 2px brass border alone
       is below the 3:1 indicator minimum on this light ground. */
  }
  .mega-menu__item-title {
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--c-ink);
    letter-spacing: var(--ls-snug);
  }
  .mega-menu__item-blurb {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
    line-height: 1.45;
  }
  .mega-menu__cta {
    padding: var(--s-6);
    background: var(--c-pine-deep);
    color: var(--c-bg);
    border-radius: var(--r-md);
    display: grid;
    align-content: start;
    align-self: start;
    gap: var(--s-3);
  }
  .mega-menu__cta .eyebrow {
    color: var(--c-accent);
  }
  .mega-menu__cta-line {
    font-family: var(--ff-display);
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: var(--ls-snug);
  }
  .mega-menu__cta-link {
    margin-top: auto;
    color: var(--c-accent);
    font-family: var(--ff-display);
    font-weight: 600;
    letter-spacing: var(--ls-snug);
  }
  .mega-menu__cta-link:hover {
    color: var(--c-accent-hover);
  }
  .mega-menu__footer {
    grid-column: 1 / -1;
    border-top: 1px solid var(--c-line-soft);
    padding-top: var(--s-4);
  }
  .mega-menu__overview {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: var(--ls-snug);
    color: var(--c-ink);
    transition: color var(--d-fast) var(--ease-out);
  }
  .mega-menu__overview:hover,
  .mega-menu__overview:focus-visible {
    color: var(--c-accent-deep);
  }

  @media (max-width: 900px) {
    .mega-menu__inner {
      grid-template-columns: 1fr;
      gap: var(--s-6);
      padding-block: var(--s-6);
    }
    .mega-menu__group--wide,
    .mega-menu__footer {
      grid-column: auto;
    }
    .mega-menu__group--wide .mega-menu__list {
      grid-template-columns: 1fr;
    }
  }
</style>
