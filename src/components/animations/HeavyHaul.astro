---
/**
 * Industry hero — Machinery & Equipment.
 *
 * Step-deck silhouette with a piece of heavy iron on the lower deck. On
 * scroll-in the planned route arc draws, the origin dot lands, the destination
 * emits the house brass pulse ring, and the chain straps draw down in sequence.
 * A brass shipment dot then runs the curved route on repeat via `travelAlong`
 * (MotionPath) — same motion language as the hero freight network.
 *
 * Reduced motion: route + straps drawn, destination resolved, no traveling dot.
 */
---
<div class="heavy-haul" data-heavy-haul>
  <svg viewBox="0 0 520 260" role="img" aria-label="Animated step-deck trailer with heavy machinery and a planned route">
    <!-- Route arc — drawn first -->
    <path id="hh-route" data-route
          d="M70 70 C 170 30, 320 30, 460 80"
          fill="none" stroke="var(--c-accent)" stroke-width="1.5" stroke-linecap="round" />

    <!-- Route endpoint markers -->
    <circle data-origin cx="70" cy="70" r="4" fill="var(--c-accent)" />
    <circle data-pulse cx="460" cy="80" r="6" />
    <circle cx="460" cy="80" r="3" fill="var(--c-accent)" />

    <!-- Route labels -->
    <text x="70" y="58" text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.12em">ORIGIN</text>
    <text x="460" y="100" text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.12em">DESTINATION</text>

    <!-- Ground -->
    <line x1="20" y1="220" x2="500" y2="220" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Step-deck trailer: upper deck (rear) and lower deck (front) -->
    <g transform="translate(60, 170)">
      <!-- Cab -->
      <rect x="-26" y="-22" width="26" height="44" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-22" y="-18" width="18" height="14" fill="var(--c-pine)" />
      <!-- Upper deck (over cab) -->
      <rect x="0" y="-6" width="80" height="10" fill="var(--c-line)" />
      <line x1="0" y1="-6" x2="80" y2="-6" stroke="var(--c-pine)" stroke-width="1.5" />
      <!-- Step transition -->
      <line x1="80" y1="-6" x2="80" y2="14" stroke="var(--c-pine)" stroke-width="1.5" />
      <!-- Lower deck (rear) -->
      <rect x="80" y="14" width="280" height="10" fill="var(--c-line)" />
      <line x1="80" y1="14" x2="360" y2="14" stroke="var(--c-pine)" stroke-width="1.5" />

      <!-- Heavy iron on lower deck (static silhouette) -->
      <g transform="translate(120, -38)">
        <!-- Body -->
        <rect x="0" y="0" width="140" height="52" fill="var(--c-accent)" opacity="0.92" />
        <!-- Top cab/housing -->
        <rect x="20" y="-22" width="70" height="22" fill="var(--c-accent)" opacity="0.92" />
        <!-- Stack/exhaust -->
        <rect x="100" y="-16" width="8" height="16" fill="var(--c-accent-ink)" opacity="0.6" />
        <!-- Mounting bolts (visual texture) -->
        <circle cx="14" cy="42" r="2" fill="var(--c-accent-ink)" opacity="0.55" />
        <circle cx="126" cy="42" r="2" fill="var(--c-accent-ink)" opacity="0.55" />
        <circle cx="14" cy="10" r="2" fill="var(--c-accent-ink)" opacity="0.55" />
        <circle cx="126" cy="10" r="2" fill="var(--c-accent-ink)" opacity="0.55" />
      </g>

      <!-- Chain straps -->
      <g stroke="var(--c-pine)" stroke-width="1.25" fill="none">
        <line data-strap x1="130" y1="-44" x2="130" y2="14" />
        <line data-strap x1="180" y1="-44" x2="180" y2="14" />
        <line data-strap x1="230" y1="-44" x2="230" y2="14" />
      </g>

      <!-- Wheels -->
      <circle cx="-12" cy="46" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="30" cy="46" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="320" cy="46" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="354" cy="46" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
    </g>

    <!-- Traveling dot on the route -->
    <circle data-travel r="4" />

    <!-- Permit / pilot mono badges -->
    <g font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.12em">
      <text x="200" y="22">PERMITS ROUTED</text>
      <text x="360" y="22">· PILOTS DISPATCHED</text>
    </g>

    <!-- Bottom caption -->
    <text x="260" y="246" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      HEAVY IRON · ROUTED THE WAY IT HAS TO RIDE
    </text>
  </svg>
</div>

<style>
  .heavy-haul svg { width: 100%; height: auto; display: block; }
  .heavy-haul [data-travel] { fill: var(--c-pine-deep); filter: drop-shadow(0 0 4px var(--c-accent)); }
  .heavy-haul [data-pulse] { fill: none; stroke: var(--c-accent); stroke-width: 1.5; opacity: 0; }
</style>

<script>
  import { scene, prepDraw, pulseRing, travelAlong, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-heavy-haul]");
  if (root) {
    const route = root.querySelector<SVGPathElement>("[data-route]");
    const origin = root.querySelector<SVGCircleElement>("[data-origin]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const straps = [...root.querySelectorAll<SVGLineElement>("[data-strap]")];
    const travel = root.querySelector<SVGCircleElement>("[data-travel]");

    const setStatic = (g: typeof import("gsap").gsap) => {
      if (route) prepDraw(route, false);
      straps.forEach((s) => prepDraw(s, false));
      g.set(origin, { scale: 1, transformOrigin: "center", opacity: 1 });
      g.set(travel, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        if (route) prepDraw(route);
        straps.forEach((s) => prepDraw(s));
        g.set(origin, { scale: 0, transformOrigin: "center" });
        g.set(travel, { opacity: 0 });

        // Route arc draws in.
        if (route) tl.to(route, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw });

        // Origin dot lands.
        tl.to(origin, { scale: 1, duration: DUR.fast, ease: EASE.settle }, "-=0.2");

        // Destination emits the house brass pulse ring.
        if (pulse) pulseRing(tl, pulse, { from: 6, to: 26, at: "-=0.1" });

        // Chain straps draw down, one after another.
        tl.to(straps, { strokeDashoffset: 0, duration: DUR.base, ease: EASE.draw, stagger: 0.15 }, "-=1.1");

        // Brass shipment dot runs the arc on repeat.
        if (travel) {
          tl.to(travel, { opacity: 1, duration: 0.2 }, ">-0.2");
          travelAlong(tl, travel, "#hh-route", { duration: DUR.travel * 2, repeat: -1, at: "<" });
        }
      },
      { start: "top 80%", reduced: setStatic },
    );
  }
</script>
