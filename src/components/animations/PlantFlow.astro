---
/**
 * Industry hero — Manufacturing & Industrial.
 *
 * Brass pallets flow from the docked trailer into the factory across an ~88px
 * span, each carrying the house drop-shadow trail. Smoke puffs rise off the two
 * stacks and fade, staggered, on a loop. Same brass travel language as the hero,
 * TransloadFlow and CoverageReveal. Looping, gated to the viewport.
 *
 * Reduced motion: pallets resting mid-span, puffs faint and static.
 */
---
<div class="plant-flow" data-plant>
  <svg viewBox="0 0 520 260" role="img" aria-label="Animated factory skyline receiving pallets from a docked trailer">
    <!-- Ground -->
    <line x1="20" y1="220" x2="500" y2="220" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Trailer at the dock (left) -->
    <g transform="translate(30, 150)">
      <rect x="0" y="0" width="150" height="70" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-30" y="20" width="26" height="30" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-26" y="24" width="18" height="14" fill="var(--c-pine)" />
      <circle cx="-12" cy="76" r="7" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="28" cy="76" r="7" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="130" cy="76" r="7" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <text x="75" y="92" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.12em">INBOUND</text>
    </g>

    <!-- Factory skyline (right) — silhouette outline -->
    <g transform="translate(280, 80)" stroke="var(--c-pine)" stroke-width="1.5" fill="none">
      <path d="M0 140 L0 100 L40 100 L40 70 L80 70 L80 50 L130 50 L130 30 L180 30 L180 0 L210 0 L210 140 Z" />
      <!-- Stack 1 -->
      <line x1="50" y1="100" x2="50" y2="40" />
      <line x1="60" y1="100" x2="60" y2="40" />
      <rect x="46" y="36" width="18" height="8" fill="var(--c-pine)" />
      <!-- Stack 2 -->
      <line x1="155" y1="50" x2="155" y2="-10" />
      <line x1="165" y1="50" x2="165" y2="-10" />
      <rect x="151" y="-14" width="18" height="8" fill="var(--c-pine)" />
      <!-- Windows -->
      <g stroke="var(--c-line)" stroke-width="1">
        <line x1="10" y1="116" x2="30" y2="116" />
        <line x1="10" y1="128" x2="30" y2="128" />
        <line x1="90" y1="90" x2="120" y2="90" />
        <line x1="90" y1="105" x2="120" y2="105" />
        <line x1="140" y1="70" x2="170" y2="70" />
        <line x1="140" y1="90" x2="170" y2="90" />
        <line x1="190" y1="20" x2="200" y2="20" />
        <line x1="190" y1="40" x2="200" y2="40" />
      </g>
    </g>

    <!-- Smoke puffs (rise + fade, staggered) -->
    <circle class="pf-puff" data-puff cx="335" cy="100" r="6" fill="var(--c-line)" opacity="0" />
    <circle class="pf-puff" data-puff cx="440" cy="56" r="5" fill="var(--c-line)" opacity="0" />

    <!-- Pallets flowing from trailer into factory -->
    <g class="pf-pallets">
      <rect class="pf-pallet" data-pallet x="180" y="190" width="22" height="14" />
      <rect class="pf-pallet" data-pallet x="180" y="190" width="22" height="14" />
      <rect class="pf-pallet" data-pallet x="180" y="190" width="22" height="14" />
      <rect class="pf-pallet" data-pallet x="180" y="190" width="22" height="14" />
    </g>

    <!-- Direction arrow -->
    <g stroke="var(--c-ink-muted)" stroke-width="1" fill="none">
      <path d="M180 198 L268 198 M264 194 L268 198 L264 202" />
    </g>

    <!-- Label -->
    <text x="260" y="36" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      Inbound. JIT. Cross-docked. Out the back.
    </text>
    <text x="260" y="246" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      THE LINE NEVER STOPS BECAUSE THE FREIGHT NEVER STOPS
    </text>
  </svg>
</div>

<style>
  .plant-flow svg { width: 100%; height: auto; display: block; }
  .pf-pallet { fill: var(--c-accent); filter: drop-shadow(0 0 4px var(--c-accent)); }
</style>

<script>
  import { scene, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-plant]");
  if (root) {
    const pallets = [...root.querySelectorAll<SVGRectElement>("[data-pallet]")];
    const puffs = [...root.querySelectorAll<SVGCircleElement>("[data-puff]")];

    const SPAN = 88; // inbound → factory span (unchanged from the CSS original)

    const setStatic = (g: typeof import("gsap").gsap) => {
      pallets.forEach((p, i) => g.set(p, { x: i * 22, opacity: 1 }));
      g.set(puffs, { opacity: 0.35, y: -6 });
    };

    scene(
      root,
      (tl, g) => {
        g.set(pallets, { x: 0, opacity: 0 });
        g.set(puffs, { opacity: 0, y: 0 });

        // Pallets flow across the span, carrying the brass trail.
        const CYCLE = DUR.travel / 2;
        pallets.forEach((p, i) => {
          const t = i * CYCLE;
          tl.set(p, { x: 0, opacity: 0 }, t)
            .to(p, { opacity: 1, duration: DUR.fast }, t)
            .to(p, { x: SPAN, duration: DUR.travel, ease: EASE.linear }, t)
            .to(p, { opacity: 0, duration: DUR.fast }, t + DUR.travel - DUR.fast);
        });

        // Smoke puffs rise off the stacks and fade — staggered, looping with the scene.
        puffs.forEach((puff, i) => {
          tl.fromTo(
            puff,
            { y: 0, opacity: 0 },
            {
              keyframes: [
                { opacity: 0.55, y: -6, duration: 0.3 },
                { opacity: 0.45, y: -16, duration: 0.6 },
                { opacity: 0, y: -26, duration: 0.5 },
              ],
              ease: EASE.out,
              repeat: 2,
            },
            i * 0.7,
          );
        });
      },
      { loop: true, reduced: setStatic },
    );
  }
</script>
