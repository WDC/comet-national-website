---
/**
 * Industry hero — Construction.
 *
 * Beam-by-beam, the building rises above a static flatbed. On scroll-in the 4
 * vertical beams draw upward (staggered), the 3 floor decks draw across, and the
 * crown emits the house brass pulse ring. A delivery dot then runs the dashed
 * route from flatbed to building on repeat via `travelAlong` (MotionPath) — same
 * motion language as the home-page freight network.
 *
 * Reduced motion: building fully drawn, crown resolved, no traveling dot.
 */
---
<div class="construction-rise" data-construction-rise>
  <svg viewBox="0 0 520 280" role="img" aria-label="Animated building rising above a flatbed truck delivering steel">
    <!-- Ground line -->
    <line x1="20" y1="240" x2="500" y2="240" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Flatbed (static) -->
    <g transform="translate(40, 196)">
      <rect x="0" y="0" width="170" height="14" fill="var(--c-line)" />
      <line x1="0" y1="0" x2="170" y2="0" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-26" y="-6" width="22" height="22" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-22" y="-2" width="14" height="10" fill="var(--c-pine)" />
      <circle cx="-14" cy="40" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="32" cy="40" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="146" cy="40" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <!-- Steel bundle on the deck (static) -->
      <rect x="20" y="-10" width="120" height="8" fill="var(--c-accent)" opacity="0.92" />
      <rect x="28" y="-18" width="108" height="6" fill="var(--c-accent)" opacity="0.85" />
    </g>

    <!-- Rising building (right side) — 4 beams drawn vertically + 3 floors drawn horizontally -->
    <g class="building" transform="translate(280, 0)">
      <!-- Vertical beams -->
      <line data-beam x1="20" y1="240" x2="20" y2="60" stroke="var(--c-accent)" stroke-width="2" />
      <line data-beam x1="70" y1="240" x2="70" y2="60" stroke="var(--c-accent)" stroke-width="2" />
      <line data-beam x1="130" y1="240" x2="130" y2="60" stroke="var(--c-accent)" stroke-width="2" />
      <line data-beam x1="190" y1="240" x2="190" y2="60" stroke="var(--c-accent)" stroke-width="2" />
      <!-- Floor decks -->
      <line data-deck x1="20" y1="180" x2="190" y2="180" stroke="var(--c-pine)" stroke-width="1.5" />
      <line data-deck x1="20" y1="120" x2="190" y2="120" stroke="var(--c-pine)" stroke-width="1.5" />
      <line data-deck x1="20" y1="60" x2="190" y2="60" stroke="var(--c-pine)" stroke-width="1.5" />
      <!-- Crown indicator -->
      <circle data-pulse cx="105" cy="50" r="5" />
      <circle data-crown cx="105" cy="50" r="5" fill="var(--c-accent)" opacity="0.9" />
    </g>

    <!-- Route line + traveling dot from flatbed to building -->
    <path id="cn-route" data-route d="M210 220 Q 250 220 280 230" fill="none" stroke="var(--c-line)" stroke-width="1" stroke-dasharray="3 4" />
    <circle data-travel r="3" />

    <!-- Label -->
    <text x="260" y="32" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      Steel on Tuesday. Pour on Friday.
    </text>
    <text x="260" y="266" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      DELIVERED ON THE SCHEDULE THAT MATTERS
    </text>
  </svg>
</div>

<style>
  .construction-rise svg { width: 100%; height: auto; display: block; }
  .construction-rise [data-travel] { fill: var(--c-pine-deep); filter: drop-shadow(0 0 4px var(--c-accent)); }
  .construction-rise [data-pulse] { fill: none; stroke: var(--c-accent); stroke-width: 1.5; opacity: 0; }
</style>

<script>
  import { scene, prepDraw, pulseRing, travelAlong, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-construction-rise]");
  if (root) {
    const beams = [...root.querySelectorAll<SVGLineElement>("[data-beam]")];
    const decks = [...root.querySelectorAll<SVGLineElement>("[data-deck]")];
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const crown = root.querySelector<SVGCircleElement>("[data-crown]");
    const travel = root.querySelector<SVGCircleElement>("[data-travel]");

    const setStatic = (g: typeof import("gsap").gsap) => {
      beams.forEach((b) => prepDraw(b, false));
      decks.forEach((d) => prepDraw(d, false));
      g.set(crown, { scale: 1, transformOrigin: "center", opacity: 0.9 });
      g.set(travel, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        beams.forEach((b) => prepDraw(b));
        decks.forEach((d) => prepDraw(d));
        g.set(crown, { scale: 0, transformOrigin: "center" });
        g.set(travel, { opacity: 0 });

        // Vertical beams rise, one after another.
        tl.to(beams, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw, stagger: 0.15 });

        // Floor decks draw across.
        tl.to(decks, { strokeDashoffset: 0, duration: DUR.base, ease: EASE.draw, stagger: 0.15 }, "-=0.3");

        // Crown lands and emits the house brass pulse ring.
        tl.to(crown, { scale: 1, duration: DUR.fast, ease: EASE.settle }, "-=0.2");
        if (pulse) pulseRing(tl, pulse, { from: 5, to: 24, at: "<" });

        // Delivery dot runs the dashed route on repeat.
        if (travel) {
          tl.to(travel, { opacity: 1, duration: 0.2 }, ">-0.4");
          travelAlong(tl, travel, "#cn-route", { duration: DUR.travel, repeat: -1, at: "<" });
        }
      },
      { start: "top 80%", reduced: setStatic },
    );
  }
</script>
