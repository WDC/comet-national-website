---
/**
 * Industry hero — Construction.
 * Beam-by-beam, the building rises above a static flatbed. Lines draw on scroll
 * using the shared `.draw` keyframe; a traveling dot follows the delivery route
 * via `.travel`. Pure SVG + CSS — same framework as home-page animations.
 */
---
<div class="construction-rise" data-anim>
  <svg viewBox="0 0 520 280" role="img" aria-label="Animated building rising above a flatbed truck delivering steel">
    <!-- Ground line -->
    <line x1="20" y1="240" x2="500" y2="240" stroke="var(--c-navy)" stroke-width="1.5" />

    <!-- Flatbed (static) -->
    <g transform="translate(40, 196)">
      <rect x="0" y="0" width="170" height="14" fill="var(--c-line)" />
      <line x1="0" y1="0" x2="170" y2="0" stroke="var(--c-navy)" stroke-width="1.5" />
      <rect x="-26" y="-6" width="22" height="22" fill="none" stroke="var(--c-navy)" stroke-width="1.5" />
      <rect x="-22" y="-2" width="14" height="10" fill="var(--c-navy)" />
      <circle cx="-14" cy="40" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <circle cx="32" cy="40" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <circle cx="146" cy="40" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <!-- Steel bundle on the deck (static) -->
      <rect x="20" y="-10" width="120" height="8" fill="var(--c-accent)" opacity="0.92" />
      <rect x="28" y="-18" width="108" height="6" fill="var(--c-accent)" opacity="0.85" />
    </g>

    <!-- Rising building (right side) — 4 beams drawn vertically + 3 floors drawn horizontally -->
    <g class="building" transform="translate(280, 0)">
      <!-- Vertical beams -->
      <line x1="20" y1="240" x2="20" y2="60" stroke="var(--c-accent)" stroke-width="2"
            class="draw" style="--draw-length: 180; --draw-delay: 200ms" />
      <line x1="70" y1="240" x2="70" y2="60" stroke="var(--c-accent)" stroke-width="2"
            class="draw" style="--draw-length: 180; --draw-delay: 400ms" />
      <line x1="130" y1="240" x2="130" y2="60" stroke="var(--c-accent)" stroke-width="2"
            class="draw" style="--draw-length: 180; --draw-delay: 600ms" />
      <line x1="190" y1="240" x2="190" y2="60" stroke="var(--c-accent)" stroke-width="2"
            class="draw" style="--draw-length: 180; --draw-delay: 800ms" />
      <!-- Floor decks -->
      <line x1="20" y1="180" x2="190" y2="180" stroke="var(--c-navy)" stroke-width="1.5"
            class="draw" style="--draw-length: 170; --draw-delay: 1000ms" />
      <line x1="20" y1="120" x2="190" y2="120" stroke="var(--c-navy)" stroke-width="1.5"
            class="draw" style="--draw-length: 170; --draw-delay: 1200ms" />
      <line x1="20" y1="60" x2="190" y2="60" stroke="var(--c-navy)" stroke-width="1.5"
            class="draw" style="--draw-length: 170; --draw-delay: 1400ms" />
      <!-- Crown indicator -->
      <circle cx="105" cy="50" r="5" fill="var(--c-accent)" class="pulse" opacity="0.9" />
    </g>

    <!-- Route line + traveling dot from flatbed to building -->
    <path id="cn-route" d="M210 220 Q 250 220 280 230" fill="none" stroke="var(--c-line)" stroke-width="1" stroke-dasharray="3 4" />
    <circle r="3" fill="var(--c-accent)" class="travel"
            style="offset-path: path('M210 220 Q 250 220 280 230'); --travel-duration: 3.4s; --travel-delay: 1600ms;" />

    <!-- Label -->
    <text x="260" y="32" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      Steel on Tuesday. Pour on Friday.
    </text>
    <text x="260" y="266" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      DELIVERED ON THE SCHEDULE THAT MATTERS
    </text>
  </svg>
</div>

<style>
  .construction-rise svg { width: 100%; height: auto; display: block; }
  @media (prefers-reduced-motion: reduce) {
    .construction-rise .draw { stroke-dashoffset: 0 !important; }
    .construction-rise .travel { display: none; }
    .construction-rise .pulse { animation: none; }
  }
</style>
