---
/**
 * Coverage reach dial — the "our reach" companion to the hero freight network.
 *
 * Deliberately NOT a second US map (the hero already owns the literal-map motif).
 * Instead: a radial reach diagram rooted at the Atlanta hub. Reach rings and the
 * E–W / N–S axes lay down the field, freight lanes fan out to destination nodes,
 * the hub settles with a brass glow + double pulse ring, a spoke crosses a dashed
 * Canadian-border arc, then a wave of shipments dispatches outward. The wide
 * envelope hints at continental proportions without redrawing the states.
 *
 * Same motion vocabulary as the rest of the suite (see lib/gsapMotion.scene):
 * strokeDashoffset draws, EASE.settle node pops, the house two-ring pulse, and
 * constant-speed shipment travel. Plays once on scroll-in — intentionally a
 * crisp one-shot so it doesn't compete with the hero's perpetual loop.
 *
 * Reduced motion: fully-drawn static dial, no travel. (See setStatic.)
 */
const HUB = { x: 450, y: 300 };
const ENV = { rx: 360, ry: 200 }; // outer reach envelope (continental proportion)

// A point on the reach envelope at bearing `a` (deg, y-down: 0=E, 90=S, 270=N),
// pulled in toward the hub by factor `k`.
const onEnv = (a: number, k: number) => {
  const r = (a * Math.PI) / 180;
  return { x: HUB.x + ENV.rx * k * Math.cos(r), y: HUB.y + ENV.ry * k * Math.sin(r) };
};

// Regional (near) nodes and long-haul (outer) nodes, jittered off a clean ellipse
// so the field reads organic rather than mechanical.
const MID = [
  { a: 18, k: 0.5 }, { a: 108, k: 0.47 }, { a: 200, k: 0.48 }, { a: 268, k: 0.52 },
] as const;
const OUTER = [
  { a: 2, k: 1.0 }, { a: 33, k: 0.86 }, { a: 60, k: 0.93 }, { a: 92, k: 0.8 },
  { a: 124, k: 0.9 }, { a: 150, k: 0.99 }, { a: 178, k: 1.0 }, { a: 206, k: 0.87 },
  { a: 232, k: 0.95 }, { a: 305, k: 0.9 }, { a: 332, k: 0.85 },
] as const;

type Node = { x: number; y: number; mid: boolean; border?: boolean };
const NODES: Node[] = [
  ...MID.map((n) => ({ ...onEnv(n.a, n.k), mid: true })),
  ...OUTER.map((n) => ({ ...onEnv(n.a, n.k), mid: false })),
  // Cross-border node: due north, beyond the border arc.
  { x: HUB.x - 26, y: HUB.y - ENV.ry * 1.02, mid: false, border: true },
];

// Which spokes carry a visible shipment on reveal — a spread across all bearings
// (E, W, S, SW, NE, and the cross-border run). Indices into NODES.
const SHIP_SPOKES = [4, 10, 7, 12, 14, 15];

// Reach rings (as fractions of the envelope) and axis extents.
const RINGS = [0.45, 0.72, 1.0];
const AX = { x: ENV.rx * 1.03, y: ENV.ry * 1.05 };
const BORDER_Y = HUB.y - ENV.ry * 0.82; // border arc apex
---
<div class="coverage" data-coverage>
  <svg
    viewBox="0 0 900 600"
    role="img"
    aria-label="Coverage reach diagram: freight lanes fanning out from the Atlanta hub across the continent and the Canadian border"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id="covGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--c-accent)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--c-accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Reach rings — concentric distance bands radiating from the hub -->
    <g class="cov-rings">
      {RINGS.map((k) => (
        <ellipse
          class="cov-ring" data-ring
          cx={HUB.x} cy={HUB.y} rx={ENV.rx * k} ry={ENV.ry * k}
        />
      ))}
    </g>

    <!-- Bearing axes — "east to west, north to south" -->
    <g class="cov-axes">
      <line class="cov-axis" data-axis x1={HUB.x - AX.x} y1={HUB.y} x2={HUB.x + AX.x} y2={HUB.y} />
      <line class="cov-axis" data-axis x1={HUB.x} y1={HUB.y - AX.y} x2={HUB.x} y2={HUB.y + AX.y} />
    </g>

    <!-- Cardinal ticks -->
    <g class="cov-cardinals" data-cardinals>
      <text class="cov-cardinal" x={HUB.x + AX.x + 12} y={HUB.y + 4}>E</text>
      <text class="cov-cardinal" x={HUB.x - AX.x - 22} y={HUB.y + 4}>W</text>
      <text class="cov-cardinal" x={HUB.x - 4} y={HUB.y + AX.y + 20} text-anchor="middle">S</text>
      <text class="cov-cardinal" x={HUB.x + 8} y={HUB.y - AX.y - 6}>N</text>
    </g>

    <!-- Canadian border arc — a spoke crosses it to reach beyond -->
    <path
      class="cov-border" data-border
      d={`M${HUB.x - 155} ${BORDER_Y + 42} Q${HUB.x} ${BORDER_Y} ${HUB.x + 155} ${BORDER_Y + 42}`}
    />
    <text class="cov-border-label" data-border-label x={HUB.x + 162} y={BORDER_Y + 40}>
      CANADIAN BORDER
    </text>

    <!-- Freight lanes — fan out from Atlanta -->
    <g class="cov-lanes" stroke="var(--c-accent)" stroke-linecap="round">
      {NODES.map((n) => (
        <line
          class="cov-lane" data-lane
          x1={HUB.x} y1={HUB.y} x2={n.x} y2={n.y}
          stroke-width={n.mid ? 1 : 1.3} opacity={n.mid ? 0.55 : 0.85}
        />
      ))}
    </g>

    <!-- Lane endpoint nodes -->
    <g class="cov-dots">
      {NODES.map((n) => (
        <circle
          class:list={["cov-dot", n.border && "cov-dot--border"]} data-dot
          cx={n.x} cy={n.y} r={n.border ? 4 : n.mid ? 2.5 : 3.5}
        />
      ))}
    </g>

    <!-- Shipments (pooled, reused across the dispatched spokes) -->
    <g class="cov-ships">
      {SHIP_SPOKES.map(() => (
        <circle class="cov-ship" data-ship cx={HUB.x} cy={HUB.y} r="3.5" />
      ))}
    </g>

    <!-- Atlanta hub — glow + pulse + solid core -->
    <circle class="cov-glow" data-glow cx={HUB.x} cy={HUB.y} r="52" fill="url(#covGlow)" />
    <circle class="cov-pulse" data-pulse cx={HUB.x} cy={HUB.y} r="9" />
    <g class="cov-marker" data-marker transform={`translate(${HUB.x}, ${HUB.y})`}>
      <circle r="8" fill="var(--c-accent)" />
      <circle r="3" fill="var(--c-pine-deep)" />
      <text class="cov-hub-name" x="16" y="4">ATLANTA</text>
      <text class="cov-hub-sub" x="16" y="20">LILBURN · I-85 · HUB</text>
    </g>
  </svg>
</div>

<style>
  .coverage svg { width: 100%; height: auto; }

  .cov-ring { fill: none; stroke: var(--c-accent-deep); stroke-opacity: 0.16; stroke-width: 1; }
  .cov-axis { stroke: var(--c-line); stroke-width: 1; }
  .cov-cardinal {
    fill: var(--c-ink-muted); font-family: var(--ff-mono);
    font-size: 12px; letter-spacing: 0.1em;
  }
  .cov-border { fill: none; stroke: var(--c-accent-deep); stroke-width: 1.2; stroke-dasharray: 5 5; stroke-opacity: 0.55; }
  .cov-border-label {
    fill: var(--c-ink-muted); font-family: var(--ff-mono);
    font-size: 10px; letter-spacing: 0.16em;
  }

  .cov-dot { fill: var(--c-accent); }
  .cov-dot--border { fill: var(--c-pine-deep); stroke: var(--c-accent); stroke-width: 1.5; }
  .cov-ship { fill: var(--c-pine-deep); filter: drop-shadow(0 0 4px var(--c-accent)); }
  .cov-pulse { fill: none; stroke: var(--c-accent); stroke-width: 2; opacity: 0; }
  .cov-glow { opacity: 0; }

  .cov-hub-name {
    fill: var(--c-ink); font-family: var(--ff-mono); font-size: 13px;
    font-weight: 600; letter-spacing: 0.12em;
  }
  .cov-hub-sub {
    fill: var(--c-ink-muted); font-family: var(--ff-mono);
    font-size: 10px; letter-spacing: 0.14em;
  }
</style>

<script>
  import { scene, prepDraw, pulseRing, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-coverage]");
  if (root) {
    const rings = [...root.querySelectorAll<SVGEllipseElement>("[data-ring]")];
    const axes = [...root.querySelectorAll<SVGLineElement>("[data-axis]")];
    const border = root.querySelector<SVGPathElement>("[data-border]");
    const borderLabel = root.querySelector<SVGTextElement>("[data-border-label]");
    const cardinals = root.querySelector<SVGGElement>("[data-cardinals]");
    const lanes = [...root.querySelectorAll<SVGLineElement>("[data-lane]")];
    const dots = [...root.querySelectorAll<SVGCircleElement>("[data-dot]")];
    const ships = [...root.querySelectorAll<SVGCircleElement>("[data-ship]")];
    const glow = root.querySelector<SVGCircleElement>("[data-glow]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const marker = root.querySelector<SVGGElement>("[data-marker]");
    const shipSpokes = [4, 10, 7, 12, 14, 15]; // must match SHIP_SPOKES above

    const drawables = [...rings, ...axes, ...(border ? [border] : [])];
    const structure = [cardinals, borderLabel].filter(Boolean);

    const setStatic = (g: typeof import("gsap").gsap) => {
      [...drawables, ...lanes].forEach((el) => prepDraw(el, false));
      g.set(dots, { scale: 1, transformOrigin: "center", opacity: 1 });
      g.set([glow, marker, ...structure], { opacity: 1 });
      g.set(marker, { scale: 1, transformOrigin: "center" });
      g.set(ships, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        [...drawables, ...lanes].forEach((el) => prepDraw(el));
        g.set(dots, { scale: 0, transformOrigin: "center" });
        g.set([glow, ...structure], { opacity: 0 });
        g.set(marker, { opacity: 0, scale: 0, transformOrigin: "center" });
        g.set(ships, { opacity: 0 });

        // Field lays down: reach rings + axes + border arc draw in.
        tl.to(rings, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw, stagger: 0.12 })
          .to(axes, { strokeDashoffset: 0, duration: DUR.base, ease: EASE.draw, stagger: 0.08 }, "-=0.8")
          .to([cardinals, ...(border ? [border] : [])], { opacity: 1, strokeDashoffset: 0, duration: DUR.base, ease: EASE.draw }, "<0.1");

        // Hub settles in with its glow.
        tl.to(marker, { opacity: 1, scale: 1, duration: DUR.base, ease: EASE.settle }, "-=0.5")
          .to(glow, { opacity: 1, duration: DUR.base }, "<");

        // Lanes fan outward; nodes settle-pop as each lands.
        tl.to(lanes, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw, stagger: 0.06 }, "-=0.2");
        tl.to(dots, { scale: 1, duration: DUR.fast, ease: EASE.settle, stagger: 0.06 }, "<0.3");

        // Border label + the house double pulse ring from the hub.
        if (borderLabel) tl.to(borderLabel, { opacity: 1, duration: DUR.base }, "-=0.6");
        if (pulse) pulseRing(tl, pulse, { from: 9, to: 150, at: "-=0.7", duration: 1.8 });

        // A wave of shipments dispatches along the spread of spokes.
        shipSpokes.forEach((spokeIdx, i) => {
          const lane = lanes[spokeIdx];
          const ship = ships[i];
          if (!lane || !ship) return;
          const x = lane.x2.baseVal.value;
          const y = lane.y2.baseVal.value;
          tl.set(ship, { attr: { cx: 450, cy: 300 } }, "-=1.4")
            .to(ship, { opacity: 1, duration: 0.2 }, `-=${1.3 - i * 0.16}`)
            .to(ship, { attr: { cx: x, cy: y }, duration: DUR.travel, ease: EASE.linear }, "<")
            .to(ship, { opacity: 0, duration: 0.25 }, ">-0.25");
        });
      },
      { start: "top 78%", reduced: setStatic },
    );
  }
</script>
