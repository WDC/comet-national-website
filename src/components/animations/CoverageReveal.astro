---
/**
 * Coverage map reveal — the "our reach" companion to the hero freight network.
 *
 * On scroll-in: freight lanes draw outward from Atlanta (staggered), endpoint
 * dots pop, the Atlanta hub settles with a brass glow + double pulse ring, then
 * a few shipments run the lanes. Same motion language as the hero hub so the
 * two maps feel like one system.
 *
 * Reduced motion: fully-drawn static network, no travel. (See gsapMotion.scene.)
 */
const HUB = { x: 560, y: 320 };
const ENDPOINTS = [
  [180, 200], [150, 280], [300, 380], [380, 220], [480, 165],
  [700, 200], [760, 280], [680, 410], [320, 90], [600, 95],
] as const;
// Which lanes carry a visible shipment on reveal (longest / most iconic).
const SHIP_LANES = [0, 5, 2, 9];
---
<div class="coverage" data-coverage>
  <svg
    viewBox="0 0 900 520"
    role="img"
    aria-label="Coverage map showing freight lanes across the US and southern Canada, anchored at Atlanta"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id="covGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--c-accent)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--c-accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Canada outline (southern band) -->
    <path
      class="map-outline"
      d="M50 50 L150 35 L260 25 L380 20 L500 25 L620 35 L740 50 L820 70 L860 90 L860 130 L800 145 L700 150 L580 145 L460 138 L340 135 L220 140 L120 145 L60 130 Z"
      fill="none" stroke="var(--c-line)" stroke-width="1.2"
    />
    <!-- US lower-48 outline -->
    <path
      class="map-outline"
      d="M85 170 L120 155 L200 145 L300 140 L400 138 L500 138 L580 140 L660 145 L740 155 L810 170 L840 190 L850 220 L850 260 L830 295 L810 325 L780 360 L740 390 L700 420 L650 445 L600 460 L545 470 L490 475 L435 470 L380 460 L325 445 L275 425 L225 400 L180 370 L140 335 L110 295 L90 250 L80 210 Z"
      fill="none" stroke="var(--c-line)" stroke-width="1.3"
    />

    <!-- Freight lanes — fan out from Atlanta -->
    <g class="cov-lanes" stroke="var(--c-accent)" stroke-width="1.25" stroke-linecap="round">
      {ENDPOINTS.map(([x, y]) => (
        <line class="cov-lane" data-lane x1={HUB.x} y1={HUB.y} x2={x} y2={y} opacity="0.85" />
      ))}
    </g>

    <!-- Lane endpoint dots -->
    <g class="cov-dots">
      {ENDPOINTS.map(([x, y]) => (
        <circle class="cov-dot" data-dot cx={x} cy={y} r="3" fill="var(--c-accent)" />
      ))}
    </g>

    <!-- Shipments (pooled, reused across the shipping lanes) -->
    <g class="cov-ships">
      {SHIP_LANES.map(() => (
        <circle class="cov-ship" data-ship cx={HUB.x} cy={HUB.y} r="3.5" />
      ))}
    </g>

    <!-- Atlanta hub — glow + pulse + solid core -->
    <circle class="cov-glow" data-glow cx={HUB.x} cy={HUB.y} r="46" fill="url(#covGlow)" />
    <circle class="cov-pulse" data-pulse cx={HUB.x} cy={HUB.y} r="8" />
    <g class="cov-marker" data-marker transform={`translate(${HUB.x}, ${HUB.y})`}>
      <circle r="8" fill="var(--c-accent)" />
      <circle r="3" fill="var(--c-pine-deep)" />
      <text x="16" y="4" font-family="var(--ff-mono)" font-size="13" fill="var(--c-ink)" letter-spacing="0.12em">
        ATLANTA
      </text>
      <text x="16" y="20" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
        FACILITY · HQ
      </text>
    </g>
  </svg>
</div>

<style>
  .coverage svg { width: 100%; height: auto; }
  .cov-ship { fill: var(--c-pine-deep); filter: drop-shadow(0 0 4px var(--c-accent)); }
  .cov-pulse { fill: none; stroke: var(--c-accent); stroke-width: 2; opacity: 0; }
  .cov-glow { opacity: 0; }
</style>

<script>
  import { scene, prepDraw, pulseRing, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-coverage]");
  if (root) {
    const lanes = [...root.querySelectorAll<SVGLineElement>("[data-lane]")];
    const dots = [...root.querySelectorAll<SVGCircleElement>("[data-dot]")];
    const ships = [...root.querySelectorAll<SVGCircleElement>("[data-ship]")];
    const glow = root.querySelector<SVGCircleElement>("[data-glow]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const marker = root.querySelector<SVGGElement>("[data-marker]");
    const shipLanes = [0, 5, 2, 9]; // must match SHIP_LANES above

    const setStatic = (g: typeof import("gsap").gsap) => {
      lanes.forEach((l) => prepDraw(l, false));
      g.set(dots, { scale: 1, transformOrigin: "center", opacity: 1 });
      g.set([glow, marker], { opacity: 1 });
      g.set(marker, { scale: 1, transformOrigin: "center" });
      g.set(ships, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        lanes.forEach((l) => prepDraw(l));
        g.set(dots, { scale: 0, transformOrigin: "center" });
        g.set([glow], { opacity: 0 });
        g.set(marker, { opacity: 0, scale: 0, transformOrigin: "center" });
        g.set(ships, { opacity: 0 });

        // Hub settles in first.
        tl.to(marker, { opacity: 1, scale: 1, duration: DUR.base, ease: EASE.settle })
          .to(glow, { opacity: 1, duration: DUR.base }, "<");

        // Lanes draw outward, dots pop as each lands.
        tl.to(lanes, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw, stagger: 0.09 }, "-=0.2");
        tl.to(dots, { scale: 1, duration: DUR.fast, ease: EASE.settle, stagger: 0.09 }, "<0.35");

        // Double pulse ring from the hub.
        if (pulse) pulseRing(tl, pulse, { from: 8, to: 40, at: "-=0.6" });

        // A few shipments run the longest lanes.
        shipLanes.forEach((laneIdx, i) => {
          const lane = lanes[laneIdx];
          const ship = ships[i];
          if (!lane || !ship) return;
          const x = lane.x2.baseVal.value;
          const y = lane.y2.baseVal.value;
          tl.set(ship, { attr: { cx: 560, cy: 320 } }, "-=1.2")
            .to(ship, { opacity: 1, duration: 0.2 }, `-=${1.1 - i * 0.15}`)
            .to(ship, { attr: { cx: x, cy: y }, duration: DUR.travel, ease: EASE.linear }, "<")
            .to(ship, { opacity: 0, duration: 0.25 }, ">-0.25");
        });
      },
      { start: "top 78%", reduced: setStatic },
    );
  }
</script>
