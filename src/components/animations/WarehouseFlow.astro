---
/**
 * Warehouse flow — receive → store → pick → ship, on a loop.
 *
 * A three-shelf rack holds a few stored brass pallets. Each cycle: an inbound
 * pallet slides in from the left and rises UP into the empty top-left slot
 * (store), then an outbound pallet slides out of the rack to the waiting van
 * at the right edge (pick / ship). Constant-speed travel + settle snap are the
 * same motion language as the hero shipments.
 *
 * Reduced motion: stored pallets in the rack + van present, static.
 */
---
<div class="warehouse" data-warehouse>
  <svg
    viewBox="0 0 380 190"
    role="img"
    aria-label="A warehouse rack receiving an inbound pallet into storage, then picking a stored pallet and loading it onto a waiting van"
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- Floor -->
    <line x1="14" y1="165" x2="366" y2="165" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Rack frame: 3 shelves, 2 bays -->
    <g class="wf-rack" stroke="var(--c-pine)" stroke-width="1.25" fill="none">
      <line x1="50" y1="45" x2="50" y2="165" />
      <line x1="140" y1="45" x2="140" y2="165" />
      <line x1="230" y1="45" x2="230" y2="165" />
      <line x1="50" y1="55" x2="230" y2="55" />
      <line x1="50" y1="100" x2="230" y2="100" />
      <line x1="50" y1="145" x2="230" y2="145" />
    </g>

    <!-- Stored pallets (static context) -->
    <g class="wf-stored" fill="var(--c-accent)" opacity="0.9">
      <rect x="60" y="41" width="24" height="14" />
      <rect x="150" y="41" width="24" height="14" />
      <rect x="60" y="86" width="24" height="14" />
      <rect x="152" y="86" width="24" height="14" />
      <rect x="60" y="131" width="24" height="14" />
      <rect x="110" y="131" width="24" height="14" />
    </g>

    <!-- Van at the right edge -->
    <g class="wf-van" transform="translate(250, 105)">
      <rect x="0" y="8" width="78" height="46" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="78" y="24" width="20" height="30" fill="var(--c-pine)" />
      <circle cx="20" cy="58" r="6" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <circle cx="60" cy="58" r="6" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <circle cx="90" cy="58" r="6" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
    </g>

    <!-- Inbound pallet (received → stored) -->
    <rect class="wf-move" data-inbound x="60" y="41" width="24" height="14" fill="var(--c-accent)" />

    <!-- Outbound pallet (picked → shipped) -->
    <rect class="wf-move" data-outbound x="192" y="131" width="24" height="14" fill="var(--c-accent)" />

    <!-- Caption -->
    <text x="190" y="182" text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      RECEIVE · STORE · PICK · SHIP
    </text>
  </svg>
</div>

<style>
  .warehouse svg { width: 100%; height: auto; display: block; }
  .wf-move { filter: drop-shadow(0 0 4px var(--c-accent)); }
</style>

<script>
  import { scene, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-warehouse]");
  if (root) {
    const inbound = root.querySelector<SVGRectElement>("[data-inbound]");
    const outbound = root.querySelector<SVGRectElement>("[data-outbound]");

    const setStatic = (g: typeof import("gsap").gsap) => {
      // Inbound pallet resting stored in the top-left slot; outbound put away.
      g.set(inbound, { attr: { x: 60, y: 41 }, opacity: 1 });
      g.set(outbound, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        g.set(inbound, { attr: { x: -40, y: 150 }, opacity: 0 });
        g.set(outbound, { attr: { x: 192, y: 131 }, opacity: 0 });

        // RECEIVE — inbound slides in from the left at floor level.
        tl.to(inbound, { opacity: 1, duration: 0.2 })
          .to(inbound, { attr: { x: 60 }, duration: DUR.travel, ease: EASE.linear }, "<")
          // STORE — rises up into the empty top-left slot.
          .to(inbound, { attr: { y: 41 }, duration: DUR.base, ease: EASE.settle }, "+=0.05")
          .to(inbound, { opacity: 0, duration: 0.25 }, "+=0.35");

        // PICK — outbound appears in a rack slot.
        tl.to(outbound, { opacity: 1, duration: 0.2 }, "-=0.2")
          // SHIP — slides out to the waiting van.
          .to(outbound, { attr: { x: 288, y: 124 }, duration: DUR.travel, ease: EASE.linear }, "+=0.05")
          .to(outbound, { opacity: 0, duration: 0.25 }, ">-0.15");
      },
      { start: "top 80%", loop: true, repeatDelay: 0.5, reduced: setStatic },
    );
  }
</script>
