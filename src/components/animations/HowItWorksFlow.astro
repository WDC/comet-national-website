---
/**
 * How It Works — 3 steps.
 *
 * On scroll-in (play once): each circular node lights up sequentially — border +
 * background settle to brass with a subtle scale pop (EASE.settle) ~0.4s apart —
 * and a thin brass connector bar draws (scaleX 0→1, EASE.draw) across the gap
 * between consecutive nodes, timed between the two node pops. Same motion
 * language as the rest of the suite (see gsapMotion.scene).
 *
 * Reduced motion: all nodes lit, connectors full — a clean static end-state.
 */
const steps = [
  { id: 1, title: "Get a quote", body: "One call, every mode. We match the right trailer to your load." },
  { id: 2, title: "Schedule the shipment", body: "Pickup, transload, paperwork, delivery — handled." },
  { id: 3, title: "Rest easy", body: "Real updates, real people. We solve the whole problem." },
];
---
<div class="how-flow" data-how-flow>
  <ol class="how-flow__steps">
    {steps.map((s, i) => (
      <li class="how-flow__step" style={`--i: ${i}`}>
        <div class="how-flow__node" data-node>
          <span class="how-flow__num mono">0{s.id}</span>
          <svg class="how-flow__icon" viewBox="0 0 32 32" aria-hidden="true">
            {s.id === 1 && <path d="M6 8 L26 8 L26 24 L18 24 L14 28 L14 24 L6 24 Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round" />}
            {s.id === 2 && <g stroke="currentColor" stroke-width="1.5" fill="none"><rect x="6" y="8" width="20" height="16" rx="1"/><path d="M6 14 L26 14 M11 6 L11 10 M21 6 L21 10"/></g>}
            {s.id === 3 && <g stroke="currentColor" stroke-width="1.5" fill="none"><path d="M16 4 L24 10 L24 24 L16 28 L8 24 L8 10 Z"/><path d="M12 16 L15 19 L21 13"/></g>}
          </svg>
        </div>
        <div class="how-flow__body">
          <h3 class="how-flow__title">{s.title}</h3>
          <p class="how-flow__desc">{s.body}</p>
        </div>
        {i < steps.length - 1 && (
          <span class="how-flow__connector" data-connector aria-hidden="true"></span>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .how-flow__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: start;
  }
  .how-flow__step {
    position: relative;
    display: grid;
    gap: var(--s-4);
    text-align: center;
    justify-items: center;
    padding-inline: var(--s-4);
  }
  .how-flow__step:nth-child(1) { grid-column: 1; }
  .how-flow__step:nth-child(2) { grid-column: 3; }
  .how-flow__step:nth-child(3) { grid-column: 5; }

  .how-flow__node {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    border: 1.5px solid var(--c-line);
    color: var(--c-ink);
    display: grid;
    place-items: center;
    background: var(--c-bg-elevated);
    position: relative;
  }
  .how-flow__num {
    position: absolute;
    top: -22px;
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-wider);
    color: var(--c-ink-muted);
  }
  .how-flow__icon {
    width: 36px;
    height: 36px;
  }
  .how-flow__title {
    font-size: 1.25rem;
    letter-spacing: var(--ls-snug);
  }
  .how-flow__desc {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
    max-width: 28ch;
  }

  /* Connector bar — sits between this node and the next, drawn by GSAP. */
  .how-flow__connector {
    position: absolute;
    top: 45px; /* node vertical center (92px / 2, minus half the 2px bar) */
    left: calc(50% + 46px); /* right edge of this node */
    width: calc(100% - 92px); /* reaches the left edge of the next node */
    height: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (max-width: 760px) {
    .how-flow__steps {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .how-flow__step:nth-child(n) { grid-column: 1; }
    .how-flow__connector { display: none; }
  }
</style>

<script>
  import { scene, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-how-flow]");
  if (root) {
    const nodes = [...root.querySelectorAll<HTMLElement>("[data-node]")];
    const connectors = [...root.querySelectorAll<HTMLElement>("[data-connector]")];

    const cs = getComputedStyle(root);
    const accent = cs.getPropertyValue("--c-accent").trim();
    const accentInk = cs.getPropertyValue("--c-accent-ink").trim();

    const setStatic = (g: typeof import("gsap").gsap) => {
      g.set(nodes, {
        scale: 1,
        transformOrigin: "center",
        borderColor: accent,
        backgroundColor: accent,
        color: accentInk,
      });
      g.set(connectors, { scaleX: 1, transformOrigin: "left center" });
    };

    scene(
      root,
      (tl, g) => {
        g.set(nodes, { transformOrigin: "center" });
        g.set(connectors, { scaleX: 0, transformOrigin: "left center" });

        nodes.forEach((node, i) => {
          const at = i * 0.4;
          // Node lights up to brass with a subtle scale pop.
          tl.fromTo(
            node,
            { scale: 0.85 },
            {
              scale: 1,
              borderColor: accent,
              backgroundColor: accent,
              color: accentInk,
              duration: DUR.base,
              ease: EASE.settle,
            },
            at,
          );
          // Connector draws across the gap, timed between the two node pops.
          const connector = connectors[i];
          if (connector) {
            tl.to(
              connector,
              { scaleX: 1, duration: DUR.base, ease: EASE.draw },
              at + 0.2,
            );
          }
        });
      },
      { start: "top 80%", reduced: setStatic },
    );
  }
</script>
