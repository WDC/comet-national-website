---
/**
 * Stat count-up band.
 *
 * On scroll-in (play once): each number rises in (y + opacity) while a GSAP
 * proxy tweens {v:0}→target (~1.5s, EASE.out) and writes the formatted value in
 * on every update; once a number lands, its brass underline draws (scaleX 0→1,
 * EASE.draw). Same motion vocabulary as the rest of the suite (see
 * gsapMotion.scene).
 *
 * Reduced motion: final formatted values shown, underlines full.
 *
 * Values are derived from verifiable facts (founding year, service catalog,
 * coverage) rather than unaudited placeholders. Backfill richer stats in
 * Sanity later.
 */
import { SITE } from "@lib/site";
import { SERVICES } from "@lib/services";

interface Stat {
  label: string;
  value: number;
  format?: "plus" | "k";
  suffix?: string;
}
const stats: Stat[] = [
  { label: "Years in business", value: new Date().getFullYear() - SITE.foundingYear, format: "plus" },
  { label: "Lanes served", value: 48, suffix: " states + Canada" },
  { label: "Freight modes", value: SERVICES.length, suffix: " under one roof" },
  { label: "Atlanta dock", value: 1, suffix: " — every mode" },
];

// Server-render the final formatted value (mirrors the client formatNumber in
// the script below) so no-JS visitors and crawlers read the real number instead
// of a literal "0". With JS on, GSAP resets these to 0 and counts them up.
function formatStat(value: number, format?: Stat["format"]): string {
  if (format === "plus") return `${value.toLocaleString("en-US")}+`;
  if (format === "k") return `${(value / 1000).toFixed(1)}k`;
  return value.toLocaleString("en-US");
}
---
<div class="stat-band" data-stat-band>
  {stats.map((s) => (
    <div class="stat-band__stat">
      <span class="stat-band__num display" data-num data-count={s.value} data-format={s.format ?? ""}>{formatStat(s.value, s.format)}</span>
      {s.suffix && <span class="stat-band__suffix mono">{s.suffix}</span>}
      <span class="stat-band__underline" data-underline aria-hidden="true"></span>
      <span class="stat-band__label">{s.label}</span>
    </div>
  ))}
</div>

<style>
  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-8);
  }
  .stat-band__stat {
    display: grid;
    gap: var(--s-2);
    position: relative;
  }
  .stat-band__num {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    color: var(--c-ink);
    font-weight: 800;
    /* Tabular lining figures so the number holds a steady width as it counts up
       and the digits align to the underline. */
    font-feature-settings: "tnum" 1, "lnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .stat-band__suffix {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
    letter-spacing: var(--ls-wide);
  }
  .stat-band__underline {
    width: 48px;
    height: 2px;
    background: var(--c-accent);
    display: block;
    margin-top: var(--s-2);
    /* Drawn on by GSAP (scaleX 0→1); start retracted so there's no flash. */
    transform: scaleX(0);
    transform-origin: left center;
  }
  .stat-band__label {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--c-ink-muted);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    font-family: var(--ff-mono);
  }
  @media (max-width: 760px) {
    .stat-band { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import { scene, EASE, DUR } from "@lib/gsapMotion";

  // Preserve the original format logic exactly (was lib/motion.ts formatNumber).
  function formatNumber(value: number, format?: string): string {
    if (format === "plus") return `${value.toLocaleString("en-US")}+`;
    if (format === "k") return `${(value / 1000).toFixed(1)}k`;
    return value.toLocaleString("en-US");
  }

  const root = document.querySelector<HTMLElement>("[data-stat-band]");
  if (root) {
    const nums = [...root.querySelectorAll<HTMLElement>("[data-num]")];
    const underlines = [...root.querySelectorAll<HTMLElement>("[data-underline]")];

    const setStatic = (g: typeof import("gsap").gsap) => {
      nums.forEach((num) => {
        num.textContent = formatNumber(Number(num.dataset.count) || 0, num.dataset.format);
      });
      g.set(nums, { y: 0, opacity: 1 });
      g.set(underlines, { scaleX: 1, transformOrigin: "left center" });
    };

    scene(
      root,
      (tl, g) => {
        g.set(nums, { y: 16, opacity: 0 });
        g.set(underlines, { scaleX: 0, transformOrigin: "left center" });

        nums.forEach((num, i) => {
          const target = Number(num.dataset.count) || 0;
          const fmt = num.dataset.format;
          const proxy = { v: 0 };
          const at = i * 0.12;

          // Number rises in.
          tl.to(num, { y: 0, opacity: 1, duration: DUR.base, ease: EASE.out }, at);
          // Count up, writing the formatted value on every frame.
          tl.to(
            proxy,
            {
              v: target,
              duration: DUR.travel,
              ease: EASE.out,
              onUpdate: () => {
                num.textContent = formatNumber(Math.round(proxy.v), fmt);
              },
            },
            at,
          );
          // Underline draws once the number lands.
          const underline = underlines[i];
          if (underline) {
            tl.to(
              underline,
              { scaleX: 1, duration: DUR.draw, ease: EASE.draw },
              at + DUR.travel - 0.1,
            );
          }
        });
      },
      { start: "top 80%", reduced: setStatic },
    );
  }
</script>
