---
/**
 * Prompt 6 — Transload mode change.
 *
 * Brass pallets emerge from the shipping container, cross to the Atlanta dock
 * (which brightens + emits the house brass pulse ring as each pallet lands),
 * then cross to the dry van. The two arrow hints pulse in sync with the passing
 * pallet. Looping, gated to the viewport. Same motion language as the hero and
 * CoverageReveal — brass travel + pulse rings.
 *
 * Reduced motion: a couple of pallets resting at the dock, static.
 */
---
<div class="transload-viz" data-transload>
  <svg viewBox="0 0 520 220" role="img" aria-label="Animated transloading flow: pallets moving from shipping container to dry van to flatbed">
    <!-- Container (left) -->
    <g transform="translate(20, 60)">
      <rect width="140" height="100" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <line x1="20" y1="0" x2="20" y2="100" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.5" />
      <line x1="40" y1="0" x2="40" y2="100" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.5" />
      <line x1="60" y1="0" x2="60" y2="100" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.5" />
      <text x="70" y="116" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.12em">
        CONTAINER
      </text>
    </g>

    <!-- Dock (center) -->
    <g transform="translate(180, 60)">
      <rect width="160" height="100" fill="var(--c-line-soft)" stroke="var(--c-line)" stroke-width="1" />
      <text x="80" y="116" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink)" letter-spacing="0.12em">
        ATLANTA DOCK
      </text>
    </g>
    <!-- Dock consolidation flash (brightens as a pallet lands) -->
    <rect class="tl-dockglow" data-dockglow x="180" y="60" width="160" height="100" fill="var(--c-accent)" opacity="0" />
    <!-- Dock pulse ring — house two-ring brass pulse -->
    <circle class="tl-pulse" data-pulse cx="260" cy="110" r="6" />

    <!-- Van (right) -->
    <g transform="translate(360, 60)">
      <rect width="140" height="100" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="120" y="20" width="14" height="60" fill="none" stroke="var(--c-pine)" stroke-width="0.75" />
      <text x="70" y="116" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.12em">
        DRY VAN
      </text>
    </g>

    <!-- Pallets in flow (pooled, driven from the script) -->
    <g class="tl-pallets">
      <rect class="tl-pallet" data-pallet x="138" y="104" width="18" height="12" />
      <rect class="tl-pallet" data-pallet x="138" y="104" width="18" height="12" />
      <rect class="tl-pallet" data-pallet x="138" y="104" width="18" height="12" />
      <rect class="tl-pallet" data-pallet x="138" y="104" width="18" height="12" />
    </g>

    <!-- Arrow hints -->
    <g stroke="var(--c-ink-muted)" stroke-width="1" fill="none">
      <path data-arrow-in d="M168 110 L178 110 M174 106 L178 110 L174 114" />
      <path data-arrow-out d="M345 110 L355 110 M351 106 L355 110 L351 114" />
    </g>

    <!-- Label -->
    <text x="260" y="40" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      Container to van — same afternoon.
    </text>
  </svg>
</div>

<style>
  .transload-viz svg { width: 100%; height: auto; display: block; }
  .tl-pallet { fill: var(--c-accent); filter: drop-shadow(0 0 4px var(--c-accent)); }
  .tl-pulse { fill: none; stroke: var(--c-accent); stroke-width: 2; opacity: 0; }
  .tl-dockglow { opacity: 0; }
</style>

<script>
  import { scene, pulseRing, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-transload]");
  if (root) {
    const pallets = [...root.querySelectorAll<SVGRectElement>("[data-pallet]")];
    const dockGlow = root.querySelector<SVGRectElement>("[data-dockglow]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const arrowIn = root.querySelector<SVGPathElement>("[data-arrow-in]");
    const arrowOut = root.querySelector<SVGPathElement>("[data-arrow-out]");

    const DOCK_X = 115; // container exit → dock centre
    const VAN_X = 270; //  container exit → van interior

    const setStatic = (g: typeof import("gsap").gsap) => {
      g.set(pallets, { x: DOCK_X, opacity: 1 });
      g.set([arrowIn, arrowOut], { opacity: 0.5 });
      if (dockGlow) g.set(dockGlow, { opacity: 0.12 });
      if (pulse) g.set(pulse, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        g.set(pallets, { x: 0, opacity: 0 });
        g.set([arrowIn, arrowOut], { opacity: 0.35 });
        if (dockGlow) g.set(dockGlow, { opacity: 0 });

        const CYCLE = DUR.travel; // one pallet-length spacing → continuous flow
        pallets.forEach((p, i) => {
          const t = i * CYCLE;

          // Emerge from the container.
          tl.set(p, { x: 0, opacity: 0 }, t)
            .to(p, { opacity: 1, duration: DUR.fast }, t)
            // Left arrow pulses as the pallet crosses container → dock.
            .to(arrowIn, { opacity: 1, duration: DUR.fast, yoyo: true, repeat: 1 }, t)
            .to(p, { x: DOCK_X, duration: DUR.travel, ease: EASE.linear }, t);

          // Dock brightens + pulses as the pallet lands.
          const land = t + DUR.travel;
          tl.to(dockGlow, { opacity: 0.3, duration: DUR.fast, ease: EASE.out }, land)
            .to(dockGlow, { opacity: 0, duration: DUR.base }, land + DUR.fast);
          if (pulse) pulseRing(tl, pulse, { from: 6, to: 26, duration: 0.5, at: land });

          // Cross to the van; fade out as it seats.
          const depart = land + 0.3;
          tl.to(arrowOut, { opacity: 1, duration: DUR.fast, yoyo: true, repeat: 1 }, depart)
            .to(p, { x: VAN_X, duration: DUR.travel, ease: EASE.linear }, depart)
            .to(p, { opacity: 0, duration: DUR.fast }, depart + DUR.travel - DUR.fast);
        });
      },
      { loop: true, reduced: setStatic },
    );
  }
</script>
