---
/**
 * Service hero — Dry Van LTL.
 *
 * An enclosed dry van carrying a PARTIAL (less-than-truckload) load. On
 * scroll-in three brass pallets slide in from the right and snap into the left
 * of the van (staggered, EASE.settle); the remaining interior is a faint
 * diagonal-hatch "shared" area (other shippers' freight). A bracket then draws
 * over the trailer (prepDraw + EASE.draw) and the labels fade in — same motion
 * language as the coverage map and the flatbed "pay for the space" viz.
 *
 * Reduced motion: pallets placed, bracket drawn, labels visible. (scene → reduced)
 */
---
<div class="dry-van-ltl" data-dry-van-ltl>
  <svg viewBox="0 0 380 190" role="img" aria-label="Enclosed dry van carrying a partial LTL load — your pallets loaded on one side, the rest of the trailer shared with other shippers">
    <defs>
      <pattern id="dvDiag" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--c-line)" stroke-width="1" />
      </pattern>
    </defs>

    <!-- Ground -->
    <line x1="18" y1="138" x2="362" y2="138" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Cab (static) -->
    <rect x="20" y="66" width="34" height="46" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
    <rect x="24" y="70" width="15" height="12" fill="var(--c-pine)" />

    <!-- Enclosed trailer outline (static) -->
    <rect x="58" y="46" width="284" height="82" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />

    <!-- Shared / not-yours interior (diagonal hatch) -->
    <rect x="192" y="52" width="144" height="72" fill="url(#dvDiag)" opacity="0.5" />

    <!-- Your pallets — slide in from the right and snap into place -->
    <g class="dry-van-ltl__pallet" data-pallet>
      <rect x="66" y="56" width="36" height="62" fill="var(--c-accent)" />
      <rect x="66" y="112" width="36" height="6" fill="var(--c-pine-deep)" />
    </g>
    <g class="dry-van-ltl__pallet" data-pallet>
      <rect x="108" y="56" width="36" height="62" fill="var(--c-accent)" />
      <rect x="108" y="112" width="36" height="6" fill="var(--c-pine-deep)" />
    </g>
    <g class="dry-van-ltl__pallet" data-pallet>
      <rect x="150" y="56" width="36" height="62" fill="var(--c-accent)" />
      <rect x="150" y="112" width="36" height="6" fill="var(--c-pine-deep)" />
    </g>

    <!-- Wheels (static) -->
    <circle cx="40" cy="136" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
    <circle cx="296" cy="136" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
    <circle cx="322" cy="136" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />

    <!-- Bracket over the shared van -->
    <path data-bracket d="M66 42 L66 36 L336 36 L336 42" fill="none" stroke="var(--c-accent)" stroke-width="1.25" />

    <!-- Labels -->
    <text data-label x="201" y="28" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      LTL · SHARED VAN
    </text>
    <text data-label x="264" y="90" text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.12em">
      OTHER SHIPPERS' FREIGHT
    </text>
    <text data-label x="190" y="176" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      YOU PAY FOR YOUR PALLETS — NOT THE TRAILER
    </text>
  </svg>
</div>

<style>
  .dry-van-ltl svg { width: 100%; height: auto; display: block; }
</style>

<script>
  import { scene, prepDraw, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-dry-van-ltl]");
  if (root) {
    const pallets = [...root.querySelectorAll<SVGGElement>("[data-pallet]")];
    const bracket = root.querySelector<SVGPathElement>("[data-bracket]");
    const labels = [...root.querySelectorAll<SVGTextElement>("[data-label]")];

    const setStatic = (g: typeof import("gsap").gsap) => {
      g.set(pallets, { x: 0, opacity: 1 });
      if (bracket) prepDraw(bracket, false);
      g.set(labels, { opacity: 1 });
    };

    scene(
      root,
      (tl, g) => {
        g.set(pallets, { x: 190, opacity: 0 });
        if (bracket) prepDraw(bracket);
        g.set(labels, { opacity: 0 });

        // Pallets slide in from the right and snap into the van, one after another.
        tl.to(pallets, { x: 0, opacity: 1, duration: DUR.base, ease: EASE.settle, stagger: 0.12 });

        // Bracket draws over the shared van.
        if (bracket) tl.to(bracket, { strokeDashoffset: 0, duration: DUR.draw, ease: EASE.draw }, "-=0.1");

        // Labels fade in.
        tl.to(labels, { opacity: 1, duration: DUR.base, ease: EASE.out, stagger: 0.08 }, "-=0.4");
      },
      { start: "top 80%", reduced: setStatic },
    );
  }
</script>
