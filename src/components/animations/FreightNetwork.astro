---
/**
 * Prompt 1 — Hero freight network.
 * Stylized US outline. Lines draw from Atlanta to 7 hubs, then dots travel.
 * Pure SVG + CSS. Reduced-motion: lines render in their drawn state, no travel.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// hub coords on a 800x440 viewBox roughly approximating US lower-48
const ATL = { x: 555, y: 285 };
// Legacy badge comet glyph (traced from the Est. 1995 mark), native viewBox 1000x366.5
const COMET_MARK =
  "M478 350.3C403.3 348.8 333.5 341.2 257.1 326.5C239.2 323 210 316.7 202.8 314.7C119.7 291.8 62.7 262 34 226.3C24.4 214.3 18.2 201.1 16.6 189.1C13.7 167.8 27.6 142.4 54.2 120.1C74.4 103.2 101.6 87.9 135.9 74.2C161.8 63.8 193.1 54 217.7 48.6C336.9 22.1 445.9 12.3 562.4 17.7C607.1 19.7 655.1 24.2 691.5 29.8C799.2 46.3 890.8 77.7 940.5 115C967.4 135.2 981.6 156 983.8 178.2C986.1 201.1 973.9 224.2 948.1 245.8C900.5 285.7 804.9 319.6 691.5 337C652.3 343 600.4 347.7 553.1 349.5C531 350.4 497.8 350.7 478 350.3ZM188.5 284.4C198.6 283.5 217.3 281.2 239.9 278.1C247.2 277.1 413.3 254.8 609.2 228.7C805 202.5 965.2 181 965.2 181C965.2 180.7 193.4 82.2 189.2 81.9C184.1 81.6 171 81.8 166.1 82.4C151.1 84 139.4 87.3 128 92.9C114.1 99.8 104.7 108.2 95 122.5C88.9 131.6 83.4 142.6 80.3 152.3C78.2 158.7 76.6 166.3 75.7 173.5C75.3 177.4 75.3 189.9 75.7 193.8C76.8 203.2 79 212 82.3 220.3C94.3 250.4 117.9 271.2 150.6 280.5C157 282.3 166.9 284.1 173.4 284.6C176.7 284.9 184.3 284.7 188.5 284.4Z";
const HUBS = [
  { name: "Seattle", x: 130, y: 95 },
  { name: "Los Angeles", x: 145, y: 270 },
  { name: "Dallas", x: 415, y: 320 },
  { name: "Chicago", x: 510, y: 195 },
  { name: "New York", x: 680, y: 180 },
  { name: "Miami", x: 640, y: 380 },
  { name: "Denver", x: 305, y: 220 },
];
---
<svg
  class={`freight-network ${className}`}
  viewBox="0 0 800 440"
  role="img"
  aria-label="Animated freight network with Atlanta hub connecting to seven major US cities"
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <!-- Comet glyph from the legacy badge; centered on origin so offset-path can carry it -->
    <path id="comet-glyph" d={COMET_MARK} transform="translate(-9 -3.3) scale(0.018)" fill-rule="evenodd" />
  </defs>

  <!-- Simplified US outline -->
  <path
    class="us-outline"
    d="M75 130 L95 95 L150 70 L210 55 L265 50 L325 55 L385 60 L445 65 L500 65 L545 70 L590 75 L640 75 L690 80 L725 90 L755 110 L770 140 L770 175 L750 200 L740 220 L735 245 L728 270 L725 295 L715 320 L695 345 L670 365 L640 380 L600 388 L560 390 L520 388 L475 380 L425 370 L380 360 L335 350 L290 340 L245 325 L205 310 L165 290 L130 265 L100 235 L80 200 L70 165 Z"
    fill="none"
    stroke="var(--c-line)"
    stroke-width="1.25"
    stroke-linejoin="round"
  />

  <!-- Connecting lines from Atlanta -->
  {HUBS.map((h, i) => {
    const dx = h.x - ATL.x;
    const dy = h.y - ATL.y;
    const length = Math.round(Math.sqrt(dx * dx + dy * dy));
    return (
      <line
        x1={ATL.x}
        y1={ATL.y}
        x2={h.x}
        y2={h.y}
        stroke="var(--c-accent)"
        stroke-width="1.5"
        stroke-linecap="round"
        class="draw"
        style={`--draw-length: ${length}; --draw-delay: ${300 + i * 120}ms`}
      />
    );
  })}

  <!-- Hub dots -->
  {HUBS.map((h, i) => (
    <circle
      cx={h.x}
      cy={h.y}
      r="3.5"
      fill="var(--c-accent)"
      class="reveal"
      style={`--reveal-delay: ${600 + i * 120}ms`}
      data-reveal
    />
  ))}

  <!-- Atlanta hub (pulsing larger) -->
  <g transform={`translate(${ATL.x}, ${ATL.y})`}>
    <circle r="9" fill="none" stroke="var(--c-accent)" stroke-width="1.25" class="pulse" opacity="0.55" />
    <circle r="5" fill="var(--c-accent)" />
    <circle r="2" fill="var(--c-pine-deep)" />
  </g>

  <!-- Traveling comet glyphs along each line -->
  {HUBS.map((h, i) => {
    const dx = h.x - ATL.x;
    const dy = h.y - ATL.y;
    return (
      <use
        href="#comet-glyph"
        fill="var(--c-accent)"
        class="travel"
        style={`
          offset-path: path('M${ATL.x} ${ATL.y} l${dx} ${dy}');
          offset-rotate: auto;
          --travel-duration: ${2.2 + (i % 3) * 0.6}s;
          --travel-delay: ${1400 + i * 200}ms;
        `}
      />
    );
  })}

  <!-- Atlanta label -->
  <g transform={`translate(${ATL.x + 12}, ${ATL.y + 4})`}>
    <text font-family="var(--ff-mono)" font-size="11" fill="var(--c-ink-muted)" letter-spacing="0.1em">
      ATL · HQ
    </text>
  </g>
</svg>

<style>
  .freight-network {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .freight-network .draw {
      stroke-dashoffset: 0 !important;
    }
    .freight-network .travel {
      display: none;
    }
    .freight-network .pulse {
      animation: none;
    }
  }
</style>
