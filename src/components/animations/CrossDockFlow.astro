---
/**
 * Prompt 7 — Cross-dock consolidation.
 *
 * Three small inbound trucks drive in from the left (staggered) toward the dock;
 * the dock flashes brass and emits the house pulse ring on consolidation; the
 * inbound loads are absorbed and one big outbound truck drives out to the right.
 * Looping, gated to the viewport. Same brass pulse + travel language as the hero.
 *
 * Reduced motion: inbound trucks arrived at the dock + outbound truck present.
 */
---
<div class="crossdock-viz" data-crossdock>
  <svg viewBox="0 0 520 240" role="img" aria-label="Cross-docking flow: three small inbound trucks consolidated into one outbound truck, and the reverse">
    <!-- Dock building -->
    <g transform="translate(200, 80)">
      <rect width="120" height="80" fill="var(--c-line-soft)" stroke="var(--c-line)" stroke-width="1" />
      <line x1="0" y1="20" x2="120" y2="20" stroke="var(--c-line)" />
      <line x1="60" y1="20" x2="60" y2="80" stroke="var(--c-line)" />
      <text x="60" y="118" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.12em">
        DOCK
      </text>
    </g>
    <!-- Dock consolidation flash + pulse ring -->
    <rect class="cd-dockglow" data-dockglow x="200" y="80" width="120" height="80" fill="var(--c-accent)" opacity="0" />
    <circle class="cd-pulse" data-pulse cx="260" cy="120" r="8" />

    <!-- Inbound: 3 small trucks (left) -->
    <g class="cd-inbound">
      {[40, 100, 160].map((y) => (
        <g transform={`translate(40, ${y})`} data-truck-in>
          <rect x="0" y="0" width="50" height="20" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
          <rect x="-12" y="4" width="14" height="14" fill="var(--c-pine)" />
          <circle cx="6" cy="22" r="3" fill="none" stroke="var(--c-pine)" stroke-width="1" />
          <circle cx="44" cy="22" r="3" fill="none" stroke="var(--c-pine)" stroke-width="1" />
          <rect x="6" y="4" width="38" height="12" fill="var(--c-accent)" opacity="0.85" />
        </g>
      ))}
    </g>

    <!-- Outbound: 1 big truck (right) -->
    <g class="cd-outbound" data-outbound transform="translate(360, 90)">
      <rect x="0" y="0" width="120" height="50" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="-22" y="14" width="20" height="22" fill="var(--c-pine)" />
      <rect x="6" y="6" width="108" height="38" fill="var(--c-accent)" />
      <circle cx="14" cy="52" r="5" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="106" cy="52" r="5" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
    </g>

    <!-- Direction arrow -->
    <g stroke="var(--c-accent)" stroke-width="1.25" fill="none">
      <path d="M150 140 L195 140 M190 136 L195 140 L190 144" />
      <path d="M325 140 L355 140 M350 136 L355 140 L350 144" />
    </g>

    <text x="260" y="40" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
      Three loads in, one load out.
    </text>
  </svg>
</div>

<style>
  .crossdock-viz svg { width: 100%; height: auto; display: block; }
  .cd-pulse { fill: none; stroke: var(--c-accent); stroke-width: 2; opacity: 0; }
  .cd-dockglow { opacity: 0; }
</style>

<script>
  import { scene, pulseRing, EASE, DUR } from "@lib/gsapMotion";

  const root = document.querySelector<HTMLElement>("[data-crossdock]");
  if (root) {
    const trucksIn = [...root.querySelectorAll<SVGGElement>("[data-truck-in]")];
    const outbound = root.querySelector<SVGGElement>("[data-outbound]");
    const dockGlow = root.querySelector<SVGRectElement>("[data-dockglow]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");

    const IN_X = 140; // inbound trucks drive right into the dock
    const OUT_X = 200; // outbound truck drives off the right edge

    const setStatic = (g: typeof import("gsap").gsap) => {
      g.set(trucksIn, { x: IN_X, opacity: 1 });
      g.set(outbound, { x: 0, opacity: 1 });
      if (dockGlow) g.set(dockGlow, { opacity: 0 });
      if (pulse) g.set(pulse, { opacity: 0 });
    };

    scene(
      root,
      (tl, g) => {
        g.set(trucksIn, { x: 0, opacity: 1 });
        g.set(outbound, { x: 0, opacity: 0 });
        if (dockGlow) g.set(dockGlow, { opacity: 0 });

        // Inbound trucks drive in, staggered.
        tl.to(trucksIn, { x: IN_X, duration: DUR.slow, ease: EASE.inOut, stagger: 0.25 }, 0.2);

        // Consolidation: dock flashes brass + house pulse ring.
        const consolidate = 0.2 + DUR.slow + 0.5;
        tl.to(dockGlow, { opacity: 0.4, duration: DUR.fast, ease: EASE.out }, consolidate)
          .to(dockGlow, { opacity: 0, duration: DUR.base }, consolidate + DUR.fast);
        if (pulse) pulseRing(tl, pulse, { from: 8, to: 34, duration: 0.6, at: consolidate });

        // Inbound loads absorbed into the dock.
        tl.to(trucksIn, { opacity: 0, duration: DUR.base }, consolidate + 0.15);

        // Outbound truck emerges and drives out to the right.
        const out = consolidate + DUR.base;
        tl.to(outbound, { opacity: 1, duration: DUR.fast }, out)
          .to(outbound, { x: OUT_X, duration: DUR.travel, ease: EASE.inOut }, out)
          .to(outbound, { opacity: 0, duration: DUR.base }, out + DUR.travel - DUR.base);
      },
      { loop: true, repeatDelay: 0.4, reduced: setStatic },
    );
  }
</script>
