---
/**
 * Prompt 5 — Flatbed LTL "pay for the space you use".
 * Top-down flatbed: 3 brass blocks slide in from right and snap into place,
 * filling ~60% of the deck. Bracket + label animate over the used portion.
 */
---
<div class="flatbed-viz" data-anim>
  <svg viewBox="0 0 480 220" role="img" aria-label="Top-down view of a partial flatbed showing the linear feet you actually pay for">
    <!-- Deck outline -->
    <rect x="20" y="60" width="440" height="100" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
    <!-- Tick marks every ~10ft equivalent -->
    {Array.from({ length: 9 }).map((_, i) => (
      <line x1={64 + i * 48} y1={156} x2={64 + i * 48} y2={164} stroke="var(--c-pine)" stroke-width="1" />
    ))}
    {Array.from({ length: 9 }).map((_, i) => (
      <text x={64 + i * 48} y={180} text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink-muted)" letter-spacing="0.08em">
        {`${(i + 1) * 5}'`}
      </text>
    ))}

    <!-- Cab indicator -->
    <rect x="0" y="76" width="20" height="68" fill="var(--c-line)" />

    <!-- Cargo blocks (slide in from right) -->
    <g class="slide-pack" transform="translate(36, 0)">
      <rect x="0" y="76" width="90" height="68" fill="var(--c-accent)" />
      <rect x="98" y="76" width="60" height="68" fill="var(--c-accent)" />
      <rect x="166" y="76" width="50" height="68" fill="var(--c-accent)" />
    </g>

    <!-- "Empty space" treatment (right side) -->
    <pattern id="diag" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="var(--c-line)" stroke-width="1" />
    </pattern>
    <rect x="260" y="60" width="200" height="100" fill="url(#diag)" opacity="0.5" />

    <!-- Bracket + label over used portion -->
    <g class="flatbed-viz__label">
      <path d="M36 50 L36 42 L252 42 L252 50" fill="none" stroke="var(--c-accent)" stroke-width="1.25" />
      <text x="144" y="34" text-anchor="middle" font-family="var(--ff-display)" font-size="14" font-weight="700" fill="var(--c-ink)" letter-spacing="-0.01em">
        You pay for this
      </text>
    </g>
    <g class="flatbed-viz__empty-label">
      <text x="360" y="34" text-anchor="middle" font-family="var(--ff-mono)" font-size="11" fill="var(--c-ink-muted)" letter-spacing="0.12em">
        NOT THIS
      </text>
    </g>

    <!-- "linear feet" rule label -->
    <text x="240" y="200" text-anchor="middle" font-family="var(--ff-mono)" font-size="10" fill="var(--c-ink-muted)" letter-spacing="0.16em">
      LINEAR FEET — NOT TOTAL TRAILER
    </text>
  </svg>
</div>

<style>
  .flatbed-viz svg { width: 100%; height: auto; display: block; }
  .flatbed-viz__label, .flatbed-viz__empty-label {
    opacity: 0;
    transition: opacity 500ms var(--ease-out) 1400ms;
  }
  .anim-on .flatbed-viz__label,
  .anim-on .flatbed-viz__empty-label { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .flatbed-viz .slide-pack > * { opacity: 1 !important; animation: none !important; }
    .flatbed-viz__label, .flatbed-viz__empty-label { opacity: 1; }
  }
</style>
