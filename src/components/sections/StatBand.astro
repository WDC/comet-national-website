---
import StatCountUp from "@components/animations/StatCountUp.astro";
---
<section class="stat-section section-tight">
  <div class="container-content">
    <p class="eyebrow stat-section__eyebrow">07 · By the numbers</p>
    <StatCountUp />
  </div>
</section>

<style>
  .stat-section {
    /* Faint dotted paper texture over the elevated ground — the dots sit in the
       soft line token so they read as depth, not pattern, behind the numerals. */
    background:
      radial-gradient(circle, var(--c-line-soft) 1px, transparent 1.6px) 0 0 / 24px 24px,
      var(--c-bg-elevated);
    border-block: 1px solid var(--c-line);
  }
  .stat-section__eyebrow {
    margin-bottom: var(--s-8);
  }
</style>
