---
import { SITE } from "@lib/site";

// Real customer references pulled from the legacy site testimonials.
// Multi-word names carry a non-breaking space so a company never wraps mid-name.
const clients = ["Sika", "Atlas Concrete", "Capital Steel", "GMC Group", "Pioneer Industrial", "Vulcan"];
---
<section class="trust" aria-label="Trusted by industrial buyers" data-trust>
  <div class="container-content trust__inner">
    <p class="trust__line"><span class="trust__accent" data-trust-dot>·</span> {SITE.trustLine}</p>
    <div class="trust__ticker marquee" data-marquee aria-label="Selected clients">
      <div class="marquee__track">
        {clients.map((c) => (
          <span class="trust__logo display">{c} <span class="trust__logo-dot" aria-hidden="true">·</span></span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--c-bg-elevated);
    border-block: 1px solid var(--c-line);
    padding-block: var(--s-6);
  }
  /* Tagline on its own line, then the wordmarks as a clean wrapping row.
     Stacking (rather than a two-column split) keeps the names readable and
     lets the row use the full width without cramming. */
  .trust__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .trust__line {
    font-family: var(--ff-display);
    font-weight: 600;
    color: var(--c-ink);
    font-size: 1rem;
    letter-spacing: var(--ls-snug);
  }
  /* Wordmarks run past as a slow ticker (pauses on hover; static wrapped row
     with no JS or under reduced motion — see flourish.css .marquee). */
  .trust__ticker { --marquee-gap: var(--s-8); }
  .trust__logo {
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-ink);
    cursor: default;
    transition: color var(--d-fast) var(--ease-out);
  }
  .trust__logo:hover { color: var(--c-accent-deep); }
  .trust__logo-dot {
    color: var(--c-accent);
    padding-inline-start: var(--s-8);
    font-weight: 400;
  }
  .trust__accent {
    color: var(--c-accent);
    display: inline-block;
    animation: trust-pulse 3s var(--ease-in-out) infinite;
  }
  /* Live-dispatch dot — a slow brass pulse. Paused when the strip is off-screen
     (see script) so it isn't animating while scrolled past. */
  @keyframes trust-pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.35); }
  }
  .trust.is-offscreen .trust__accent { animation-play-state: paused; }

  @media (max-width: 760px) {
    .trust__inner { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Pause the live-dispatch pulse while the strip is scrolled out of view.
  const strip = document.querySelector<HTMLElement>("[data-trust]");
  if (strip && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => strip.classList.toggle("is-offscreen", !entry!.isIntersecting),
      { threshold: 0 },
    );
    io.observe(strip);
  }
</script>
