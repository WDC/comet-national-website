---
import { SITE } from "@lib/site";

// Real customer references pulled from the legacy site testimonials.
// Multi-word names carry a non-breaking space so a company never wraps mid-name.
const clients = ["Sika", "Atlas Concrete", "Capital Steel", "GMC Group", "Pioneer Industrial", "Vulcan"];
---
<section class="trust" aria-label="Trusted by industrial buyers">
  <div class="container-content trust__inner">
    <p class="trust__line"><span class="trust__accent">·</span> {SITE.trustLine}</p>
    <ul class="trust__logos reveal-stagger" data-reveal aria-label="Selected clients">
      {clients.map((c) => (
        <li class="trust__logo display">{c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--c-bg-elevated);
    border-block: 1px solid var(--c-line);
    padding-block: var(--s-6);
  }
  /* Tagline on its own line, then the wordmarks as a clean wrapping row.
     Stacking (rather than a two-column split) keeps the names readable and
     lets the row use the full width without cramming. */
  .trust__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .trust__line {
    font-family: var(--ff-display);
    font-weight: 600;
    color: var(--c-ink);
    font-size: 1rem;
    letter-spacing: var(--ls-snug);
  }
  /* Flex-wrap with natural-width items: every wordmark keeps its own width,
     so long names can never overflow a fixed track and collide. Wrapped rows
     align to the left edge and share an even gap. */
  .trust__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3) clamp(var(--s-6), 4vw, var(--s-12));
  }
  .trust__logo {
    white-space: nowrap;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: var(--ls-snug);
    color: var(--c-ink-muted);
    opacity: 0.65;
    cursor: default;
    transition:
      opacity var(--d-fast) var(--ease-out),
      color var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out),
      letter-spacing var(--d-base) var(--ease-out);
  }
  .trust__logo:hover {
    opacity: 1;
    color: var(--c-ink);
    transform: translateY(-1px);
    letter-spacing: 0;
  }
  .trust__accent {
    color: var(--c-accent);
    display: inline-block;
    animation: pulse-dot 3s var(--ease-in-out) infinite;
  }
</style>
