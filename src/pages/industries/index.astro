---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import { INDUSTRIES, getService } from "@lib/services";
import { SITE } from "@lib/site";
---
<BaseLayout
  title={`Industries We Serve | ${SITE.name}`}
  description="Construction, manufacturing, building materials, and machinery & equipment. We recombine 12 freight services around the way industrial buyers actually order. Atlanta-based since 1995."
>
  <section class="industries-hero section-tight">
    <div class="container-content industries-hero__inner">
      <p class="eyebrow">Industries overview</p>
      <h1 class="industries-hero__title display reveal" data-reveal>Built around how you buy freight.</h1>
      <p class="industries-hero__lede reveal" data-reveal style="--reveal-delay: 120ms">
        Twelve services, organized four ways. We recombine flatbed, van, reefer,
        warehousing, and transload around the way construction <span class="sc">GM</span>s, plant
        managers, distributors, and equipment dealers actually move loads.
      </p>
    </div>
  </section>

  {INDUSTRIES.map((ind, gi) => (
    <section class="industries-group section">
      <div class="container-content">
        <header class="industries-group__head">
          <span class="mono industries-group__num">0{gi + 1}</span>
          <div>
            <p class="eyebrow">Industry · {ind.title}</p>
            <h2 class="industries-group__title display">
              {ind.equityLine ?? ind.blurb}
            </h2>
            {ind.heroLede && (
              <p class="industries-group__lede">{ind.heroLede}</p>
            )}
          </div>
        </header>

        <div class="industries-group__body">
          <ul class="industries-group__services reveal-stagger" data-reveal>
            {ind.serviceSlugs.map((slug) => {
              const s = getService(slug);
              if (!s) return null;
              return (
                <li>
                  <a href={`/services/${s.slug}`}>
                    <span class="industries-group__svc-title display">{s.title}</span>
                    <span class="industries-group__svc-blurb">{s.blurb}</span>
                  </a>
                </li>
              );
            })}
          </ul>

          <a href={`/industries/${ind.slug}`} class="industries-group__cta link-arrow">
            See the full {ind.title.toLowerCase()} page <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  ))}

  <section class="section container-content industries-cta">
    <h2 class="display industries-cta__title">Not sure which buyer profile fits?</h2>
    <p>Tell us about the freight. We’ll match the right modes to the way you ship.</p>
    <div class="industries-cta__actions">
      <Button href="/get-a-quote" size="lg">Get a Quote</Button>
      <a class="mono" href={`tel:${SITE.phoneE164}`}>or call {SITE.phone}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .industries-hero { background: var(--c-bg-elevated); border-bottom: 1px solid var(--c-line); }
  .industries-hero__inner { max-width: 60ch; }
  .industries-hero__title { font-size: clamp(2.75rem, 5vw, 4.5rem); line-height: 1; margin-top: var(--s-3); max-width: 16ch; }
  .industries-hero__lede { margin-top: var(--s-6); font-size: 1.125rem; color: var(--c-ink-muted); }

  .industries-group:nth-child(even) { background: var(--c-bg-elevated); }
  .industries-group__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-6);
    align-items: start;
    padding-bottom: var(--s-10);
  }
  .industries-group__num {
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 700;
    color: var(--c-line);
    line-height: 0.85;
    font-family: var(--ff-display);
  }
  .industries-group__title {
    font-size: var(--t-h1);
    line-height: 1.02;
    margin-top: var(--s-2);
    max-width: 26ch;
  }
  .industries-group__lede {
    margin-top: var(--s-5);
    color: var(--c-ink-muted);
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .industries-group__body {
    display: grid;
    gap: var(--s-8);
  }
  .industries-group__services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .industries-group__services li { background: var(--c-bg); }
  .industries-group__services a {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-3);
    padding: var(--s-5);
    color: var(--c-ink);
    min-height: 140px;
    height: 100%;
  }
  .industries-group__services a:hover { background: var(--c-bg-elevated); }
  .industries-group__svc-title { font-size: 1.125rem; line-height: 1.1; }
  .industries-group__svc-blurb { font-size: var(--t-small); color: var(--c-ink-muted); line-height: 1.5; }

  .industries-group__cta {
    color: var(--c-accent);
    font-family: var(--ff-display);
    font-weight: 600;
    letter-spacing: var(--ls-snug);
    justify-self: start;
  }

  .industries-cta { text-align: center; display: grid; gap: var(--s-3); justify-items: center; }
  .industries-cta__title { font-size: var(--t-h2); margin-top: var(--s-3); }
  .industries-cta__actions {
    margin-top: var(--s-4);
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  @media (max-width: 1080px) {
    .industries-group__services { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .industries-group__services { grid-template-columns: 1fr; }
    .industries-group__head { grid-template-columns: 1fr; gap: var(--s-3); }
  }
</style>
