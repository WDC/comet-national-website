---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import OpenDeckSecure from "@components/animations/OpenDeckSecure.astro";
import { getService } from "@lib/services";

const service = getService("flatbed-open-deck")!;
const description =
  "Full flatbed, step-deck, double-drop, and RGN service for oversized, over-height, and specialty freight. Permits, escorts, and securement handled in-house by an Atlanta team that's been hauling open deck since 1995.";

const relatedSlugs = ["flatbed-ltl", "hotshot", "transloading"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Flatbed & Open Deck Shipping | Step-Deck, Double-Drop, RGN | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  <OpenDeckSecure slot="hero-art" />

  <section data-reveal>
    <p class="eyebrow">Who Open Deck is for</p>
    <h2 class="svc-h2 display">Freight too big, too tall, or too odd for a van.</h2>
    <p class="svc-lede">
      When the load won’t fit through a dock door, exceeds standard trailer
      height, or needs a deck low enough to clear a bridge — you’re in open
      deck territory. We run every common trailer in the category, in-house.
    </p>
    <ul class="svc-bullets reveal-stagger" data-reveal>
      <li>53′ flatbed · 48′ step-deck · double-drop · RGN (removable gooseneck)</li>
      <li>Permits & pilot cars · routing around bridge and curfew restrictions</li>
      <li>Chain, strap, and tarp securement · waterproof tarping on request</li>
      <li>Driver phone numbers shared on every load · POD same day</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Equipment we run</p>
    <h2 class="svc-h2 display">The right trailer is half the quote.</h2>
    <ul class="svc-grid reveal-stagger" data-reveal>
      <li><strong class="display">53′ Flatbed</strong><span>Standard deck height. Steel, lumber, pipe, palletized industrial freight.</span></li>
      <li><strong class="display">48′ Step-Deck</strong><span>Lower rear deck — clears loads up to ~10′2″ without permits.</span></li>
      <li><strong class="display">Double-Drop</strong><span>Well between gooseneck and rear deck — for loads up to 11′6″.</span></li>
      <li><strong class="display"><span class="sc">RGN</span></strong><span>Removable gooseneck — drive-on loading for heavy machinery up to 150,000&nbsp;lbs.</span></li>
      <li><strong class="display">Conestoga</strong><span>Curtain-side flatbed — open-deck access with weather protection.</span></li>
      <li><strong class="display">Specialty rigs</strong><span>Multi-axle, extendable, and Schnabel for project freight.</span></li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Why Comet for Open Deck</p>
    <h2 class="svc-h2 display">We’ve routed permits since long before the routing software existed.</h2>
    <p class="svc-lede">
      Open deck isn’t a quote you generate — it’s a route you plan. Bridge
      heights, curfews, escort requirements, state-line transitions. We do
      that work before the truck rolls, not after. Tell us the dimensions
      and the destination; we’ll come back with the cost, the timeline, and
      the route.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .art-placeholder svg { width: 100%; height: auto; display: block; }
  .svc-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 24ch; }
  .svc-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }

  .svc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .svc-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
  }

  .svc-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .svc-grid li {
    background: var(--c-bg);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
  .svc-grid strong { font-size: 1.0625rem; color: var(--c-ink); }
  .svc-grid span { font-size: var(--t-small); color: var(--c-ink-muted); line-height: 1.5; }

  @media (max-width: 760px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
