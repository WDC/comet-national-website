---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import WarehouseFlow from "@components/animations/WarehouseFlow.astro";
import { getService } from "@lib/services";

const service = getService("warehousing-fulfillment")!;
const description =
  "Short- and long-term warehousing at our Lilburn, Atlanta facility. Pallet storage, pick-and-pack fulfillment, and inventory staging — paired with on-site carrier capacity that gets your freight back on the road.";

const relatedSlugs = ["cross-docking", "transloading", "freight-brokerage"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Warehousing & Fulfillment Atlanta | Pallet Storage, Pick & Pack | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  <WarehouseFlow slot="hero-art" />

  <section data-reveal>
    <p class="eyebrow">Who warehousing is for</p>
    <h2 class="svc-h2 display">Storage that sits where the trucks already do.</h2>
    <p class="svc-lede">
      Inventory waiting on a release date. Project freight staged for
      construction draws. Overflow that needs to go somewhere before the
      season hits. Our Lilburn facility holds it — and the same team that
      stores it can put it back on a trailer when you’re ready.
    </p>
    <ul class="svc-bullets reveal-stagger" data-reveal>
      <li>Short- and long-term · daily, weekly, monthly billing</li>
      <li>Pallet-in / pallet-out · or pick-and-pack at the carton/each level</li>
      <li>On-site carrier capacity · we store it, we ship it</li>
      <li>Lilburn, GA · 24-hour access on scheduled releases</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">What we store and handle</p>
    <h2 class="svc-h2 display">Floor space, rack space, project staging, fulfillment.</h2>
    <ul class="svc-grid reveal-stagger" data-reveal>
      <li><strong class="display">Pallet Storage</strong><span>Standard rack and floor positions, billed by the pallet-day.</span></li>
      <li><strong class="display">Bulk / Floor</strong><span>Heavy, oversized, or non-rackable freight stored on the warehouse floor.</span></li>
      <li><strong class="display">Project Staging</strong><span>Construction or plant-shutdown freight staged for sequential release.</span></li>
      <li><strong class="display">Pick & Pack</strong><span>Carton, inner-pack, or each-level picking with packing and labeling.</span></li>
      <li><strong class="display">Kitting</strong><span>Components combined into ready-to-ship assemblies before fulfillment.</span></li>
      <li><strong class="display">Inventory Counts</strong><span>Cycle counts and on-demand audits with documented variance reports.</span></li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Why Comet for warehousing</p>
    <h2 class="svc-h2 display">The storage is the easy part. Getting it back on the road is the value.</h2>
    <p class="svc-lede">
      Most warehouses store. Most carriers ship. We do both at one address —
      so when your release date hits, there’s no second <span class="sc">BOL</span>, no second
      pickup window, no second phone tree. Same dispatcher, same dock,
      same paperwork system.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .art-placeholder svg { width: 100%; height: auto; display: block; }
  .svc-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 26ch; }
  .svc-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }

  .svc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .svc-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
  }

  .svc-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .svc-grid li {
    background: var(--c-bg);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
  .svc-grid strong { font-size: 1.0625rem; color: var(--c-ink); }
  .svc-grid span { font-size: var(--t-small); color: var(--c-ink-muted); line-height: 1.5; }

  @media (max-width: 760px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
