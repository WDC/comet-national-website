---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import { getService } from "@lib/services";

const service = getService("full-truckload")!;
const description =
  "Full Truckload (FTL) dry van service for time-critical, full-trailer freight. One trailer, one customer, one delivery. Dedicated capacity across the US and Canada.";

const relatedSlugs = ["volume-ltl", "flatbed-open-deck", "refrigerated"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Full Truckload (FTL) Dry Van Shipping | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  <div slot="hero-art" class="art-placeholder">
    <svg viewBox="0 0 380 180" aria-hidden="true">
      <rect x="20" y="40" width="280" height="90" fill="none" stroke="var(--c-navy)" stroke-width="1.5" />
      <rect x="34" y="54" width="252" height="62" fill="var(--c-accent)" />
      <rect x="300" y="60" width="40" height="56" fill="none" stroke="var(--c-navy)" stroke-width="1.5" />
      <rect x="304" y="64" width="20" height="14" fill="var(--c-navy)" />
      <circle cx="58" cy="140" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <circle cx="266" cy="140" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <circle cx="320" cy="140" r="9" fill="none" stroke="var(--c-navy)" stroke-width="1.25" />
      <text x="160" y="30" text-anchor="middle" font-family="var(--ff-display)" font-size="13" font-weight="700" fill="var(--c-ink)">YOUR LOAD · WHOLE TRAILER</text>
    </svg>
  </div>

  <section data-reveal>
    <p class="eyebrow">Who FTL is for</p>
    <h2 class="t-h2 display">When the load fills the trailer — or has to ride alone.</h2>
    <p class="t-lede">
      28,000+ pounds. Tight delivery window. High-value freight that shouldn't share
      capacity. Sensitive cargo that can't be touched between pickup and drop. That's
      Full Truckload, and we run it dedicated.
    </p>
    <ul class="ftl-bullets reveal-stagger" data-reveal>
      <li>53′ dry van · liftgate available · driver-load options</li>
      <li>Direct origin-to-destination · no transfers · no consolidation</li>
      <li>Dedicated dispatch · driver phone numbers shared on request</li>
      <li>Real-time tracking · scheduled delivery windows</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">When to use FTL vs Volume LTL</p>
    <h2 class="t-h2 display">If your load is over 24 pallets — book it dedicated.</h2>
    <p class="t-lede">
      Below 24 pallets / 28 linear feet, you'll usually save with Volume LTL. Above
      that, the math flips and dedicated FTL costs less per pound while giving you
      complete control of the trailer. We'll quote both and tell you straight.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .art-placeholder svg { width: 100%; height: auto; display: block; }
  .t-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 22ch; }
  .t-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }
  .ftl-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .ftl-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
    transition: padding-left var(--d-fast) var(--ease-out), border-left-width var(--d-fast) var(--ease-out), background var(--d-fast) var(--ease-out);
  }
  .ftl-bullets li:hover {
    padding-left: calc(var(--s-4) + 4px);
    border-left-width: 4px;
    background: var(--c-bg);
  }
</style>
