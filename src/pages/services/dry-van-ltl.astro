---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import { getService } from "@lib/services";

const service = getService("dry-van-ltl")!;
const description =
  "Dry Van LTL freight on dependable lanes. Enclosed less-than-truckload for palletized, weather-sensitive cargo — no reclass surprises, single-touchpoint Atlanta dispatch since 1995.";

const relatedSlugs = ["volume-ltl", "full-truckload", "flatbed-ltl"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Dry Van LTL Shipping | Enclosed Less-Than-Truckload | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  {/* TODO: replace with custom animation (Phase 3) */}
  <div slot="hero-art" class="art-placeholder" data-anim-placeholder="dry-van-ltl">
    <svg viewBox="0 0 380 180" aria-hidden="true">
      <rect x="20" y="50" width="320" height="80" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <line x1="40" y1="50" x2="40" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="80" y1="50" x2="80" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="120" y1="50" x2="120" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="160" y1="50" x2="160" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="200" y1="50" x2="200" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="240" y1="50" x2="240" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="280" y1="50" x2="280" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <line x1="320" y1="50" x2="320" y2="130" stroke="var(--c-pine)" stroke-width="0.75" opacity="0.4" />
      <rect x="34" y="64" width="36" height="52" fill="var(--c-accent)" opacity="0.9" />
      <rect x="78" y="64" width="36" height="52" fill="var(--c-accent)" opacity="0.9" />
      <rect x="122" y="64" width="36" height="52" fill="var(--c-accent)" opacity="0.9" />
      <rect x="166" y="64" width="36" height="52" fill="var(--c-accent)" opacity="0.9" />
      <circle cx="58" cy="140" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="302" cy="140" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <text x="180" y="36" text-anchor="middle" font-family="var(--ff-display)" font-size="13" font-weight="700" fill="var(--c-ink)">PALLETIZED · ENCLOSED · DEPENDABLE LANES</text>
    </svg>
  </div>

  <section data-reveal>
    <p class="eyebrow">Who Dry Van LTL is for</p>
    <h2 class="svc-h2 display">Palletized freight that needs four walls.</h2>
    <p class="svc-lede">
      Standard pallets, cartons, drums, banded boxes — anything that wants the
      weather kept off and the dock-doors closed between pickup and delivery.
      We run it enclosed, on lanes we’ve proven.
    </p>
    <ul class="svc-bullets reveal-stagger" data-reveal>
      <li>1–10 pallets · up to ~10,000 lbs · standard 48×40 footprint</li>
      <li>Weatherproof · sealed trailer · liftgate available on request</li>
      <li>US + Canada · published transit on the lanes we run weekly</li>
      <li>Single-touchpoint Atlanta dispatch · no algorithmic rebooking</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">What rides best in a dry van</p>
    <h2 class="svc-h2 display">Built for the freight that fits the pallet.</h2>
    <ul class="cargo-grid reveal-stagger" data-reveal>
      {[
        "Banded cartons",
        "Drums & totes",
        "Bagged goods",
        "Packaged consumer goods",
        "Industrial parts (palletized)",
        "Hardware & fasteners",
        "Electronics in cases",
        "Printed materials",
        "Paper & packaging stock",
        "Janitorial supplies",
        "Food-grade dry goods",
        "Retail replenishment",
      ].map((item) => <li><span class="cargo-grid__tick">·</span>{item}</li>)}
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Why Comet for Dry Van LTL</p>
    <h2 class="svc-h2 display">No reclass risk. No phantom accessorials.</h2>
    <p class="svc-lede">
      Standard <span class="sc">LTL</span> carriers price by <span class="sc">NMFC</span> class and audit aggressively — a
      mismeasured pallet becomes a reclass invoice three weeks after delivery.
      We quote what we move and bill what we quote. If the freight’s borderline
      between <span class="sc">LTL</span> and partial, we’ll say so up front and price it the right way.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .art-placeholder svg { width: 100%; height: auto; display: block; }
  .svc-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 22ch; }
  .svc-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }

  .svc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .svc-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
  }

  .cargo-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
  }
  .cargo-grid li {
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--c-line);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    color: var(--c-ink);
  }
  .cargo-grid__tick {
    color: var(--c-accent);
    margin-right: var(--s-2);
    font-weight: bold;
  }

  @media (max-width: 760px) {
    .cargo-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
