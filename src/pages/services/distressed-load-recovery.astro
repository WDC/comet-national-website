---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import DistressedRecovery from "@components/animations/DistressedRecovery.astro";
import { getService } from "@lib/services";

const service = getService("distressed-load-recovery")!;
const description =
  "Distressed load recovery: restack, rewrap, recover. When a freight load arrives damaged, shifted, or refused — we're the dock that puts it back together. Atlanta, 24/7.";

const relatedSlugs = ["transloading", "cross-docking", "hotshot"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Distressed Load Recovery | Restack, Rewrap, Recover | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  <DistressedRecovery slot="hero-art" />

  <section data-reveal>
    <p class="eyebrow">What we recover</p>
    <h2 class="svc-h2 display">When the load arrives — but not in a condition anyone will sign for.</h2>
    <p class="svc-lede">
      A pallet stack shifted in transit. Shrink-wrap shredded by a forklift.
      A consignee refused delivery because the cartons crushed under a top
      layer that wasn’t supposed to be there. Most brokers don’t take that
      call. We do, and we do it the same day.
    </p>
    <ul class="svc-bullets reveal-stagger" data-reveal>
      <li>Dispatch 24/7 · most recoveries dock within the same shift</li>
      <li>Restack, rewrap, re-band, re-secure · cargo-specific equipment</li>
      <li>Photograph in / photograph out · documented chain of custody</li>
      <li>POD reissued · clean BOL handed to the recovery driver</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">The 911 calls we take</p>
    <h2 class="svc-h2 display">The freight problems no one else wants on their desk.</h2>
    <ul class="svc-grid reveal-stagger" data-reveal>
      <li><strong class="display">Shifted Load</strong><span>Securement failed in transit. We unload, restack, and re-secure for the final leg.</span></li>
      <li><strong class="display">Refused at Dock</strong><span>Consignee won’t sign. We take possession, recover the freight, find a buyer or return.</span></li>
      <li><strong class="display">Damaged Wrap</strong><span>Shrink-wrap torn, pallets exposed. Same-day rewrap, banding, and corner-board protection.</span></li>
      <li><strong class="display">Driver Down</strong><span>HOS expired, equipment failed, driver out. We finish the run — same trailer or transload.</span></li>
      <li><strong class="display">Tarp Failure</strong><span>Flatbed load took weather. Dry, repack, reroute under cover.</span></li>
      <li><strong class="display">Wrong-Consignee Mis-Deliver</strong><span>Freight at the wrong door. We retrieve, hold, redirect to the right address.</span></li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Why Comet for recovery</p>
    <h2 class="svc-h2 display">We’ve been the dock everyone else calls since 1995.</h2>
    <p class="svc-lede">
      Recovery is a reputation business. Insurance adjusters, claims teams,
      and dispatchers across the southeast already have our number — because
      every minute a distressed load sits costs someone money. We pick up,
      we move, we document. The paperwork is as clean as the dock when we’re
      done.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .svc-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 26ch; }
  .svc-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }

  .svc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .svc-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
  }

  .svc-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .svc-grid li {
    background: var(--c-bg);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
  .svc-grid strong { font-size: 1.0625rem; color: var(--c-ink); }
  .svc-grid span { font-size: var(--t-small); color: var(--c-ink-muted); line-height: 1.5; }

  @media (max-width: 760px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
