---
export const prerender = true;
import ServicePillarLayout from "@layouts/ServicePillarLayout.astro";
import { getService } from "@lib/services";

const service = getService("refrigerated")!;
const description =
  "Refrigerated and frozen freight, temperature-controlled coast to coast. Multi-temp reefer service from an Atlanta carrier with logged temperature data on every load.";

const relatedSlugs = ["dry-van-ltl", "full-truckload", "warehousing-fulfillment"];
---
<ServicePillarLayout
  service={service}
  pageTitle="Refrigerated Freight (Reefer) Shipping | Comet National"
  pageDescription={description}
  relatedSlugs={relatedSlugs}
>
  {/* TODO: replace with custom animation (Phase 3) */}
  <div slot="hero-art" class="art-placeholder" data-anim-placeholder="refrigerated">
    <svg viewBox="0 0 380 180" aria-hidden="true">
      <rect x="20" y="50" width="280" height="80" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="34" y="64" width="252" height="52" fill="var(--c-accent)" opacity="0.85" />
      <rect x="300" y="60" width="40" height="56" fill="none" stroke="var(--c-pine)" stroke-width="1.5" />
      <rect x="304" y="64" width="20" height="14" fill="var(--c-pine)" />
      <rect x="240" y="40" width="46" height="14" fill="var(--c-line-soft)" stroke="var(--c-pine)" stroke-width="1" />
      <text x="263" y="50" text-anchor="middle" font-family="var(--ff-mono)" font-size="9" fill="var(--c-ink)" letter-spacing="0.08em">34°F</text>
      <circle cx="58" cy="140" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="266" cy="140" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <circle cx="320" cy="140" r="9" fill="none" stroke="var(--c-pine)" stroke-width="1.25" />
      <g stroke="var(--c-line)" stroke-width="1" fill="none">
        <path d="M70 90 L70 102 M64 96 L76 96 M66 88 L74 88 M66 104 L74 104" />
        <path d="M130 90 L130 102 M124 96 L136 96 M126 88 L134 88 M126 104 L134 104" />
        <path d="M190 90 L190 102 M184 96 L196 96 M186 88 L194 88 M186 104 L194 104" />
        <path d="M250 90 L250 102 M244 96 L256 96 M246 88 L254 88 M246 104 L254 104" />
      </g>
      <text x="160" y="30" text-anchor="middle" font-family="var(--ff-display)" font-size="13" font-weight="700" fill="var(--c-ink)">TEMP-CONTROLLED · LOGGED · COAST TO COAST</text>
    </svg>
  </div>

  <section data-reveal>
    <p class="eyebrow">Who reefer is for</p>
    <h2 class="svc-h2 display">When the temperature can’t move.</h2>
    <p class="svc-lede">
      Produce, dairy, pharmaceutical, frozen, and any cargo with a tight
      temperature window. Continuous run, multi-temp where the trailer
      supports it, and a temperature log delivered with every <span class="sc">POD</span>.
    </p>
    <ul class="svc-bullets reveal-stagger" data-reveal>
      <li>53′ reefer · -20°F to 70°F · continuous and start/stop modes</li>
      <li>Multi-temp compartments available · frozen + chilled on one trailer</li>
      <li>Logged temperature data · downloadable on request</li>
      <li>Pre-cool verified before load · trailer washout records kept</li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Temperature ranges we run</p>
    <h2 class="svc-h2 display">From frozen to controlled ambient.</h2>
    <ul class="svc-grid reveal-stagger" data-reveal>
      <li><strong class="display">Frozen</strong><span>-10°F to 0°F · ice cream, frozen protein, frozen produce.</span></li>
      <li><strong class="display">Deep Chill</strong><span>28°F to 34°F · fresh meat, seafood, dairy.</span></li>
      <li><strong class="display">Fresh / Produce</strong><span>34°F to 45°F · vegetables, beverages, floral.</span></li>
      <li><strong class="display">Controlled Ambient</strong><span>55°F to 70°F · pharma, chocolate, sensitive consumer goods.</span></li>
      <li><strong class="display">Multi-Temp</strong><span>Two or three compartments · mixed loads, single trailer.</span></li>
      <li><strong class="display">Protect-from-Freeze</strong><span>Heated reefer in winter · paint, liquids, adhesives.</span></li>
    </ul>
  </section>

  <section data-reveal>
    <p class="eyebrow">Why Comet for reefer</p>
    <h2 class="svc-h2 display">A temperature log is the only <span class="sc">POD</span> that matters.</h2>
    <p class="svc-lede">
      Reefer freight that fails <span class="sc">QA</span> at delivery isn’t a freight claim — it’s a
      lost customer. We pre-cool before pickup, verify the setpoint at every
      stop, and hand you the log alongside the <span class="sc">POD</span>. If anything goes sideways
      mid-route, you hear about it from us before you hear about it from the
      consignee.
    </p>
  </section>
</ServicePillarLayout>

<style>
  .art-placeholder svg { width: 100%; height: auto; display: block; }
  .svc-h2 { font-size: var(--t-h2); line-height: 1.05; margin-top: var(--s-3); margin-bottom: var(--s-5); max-width: 24ch; }
  .svc-lede { color: var(--c-ink-muted); max-width: 64ch; font-size: 1.0625rem; }

  .svc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-3);
  }
  .svc-bullets li {
    padding: var(--s-3) var(--s-4);
    border-left: 2px solid var(--c-accent);
    font-family: var(--ff-mono);
    font-size: var(--t-small);
    background: var(--c-bg-elevated);
  }

  .svc-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .svc-grid li {
    background: var(--c-bg);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
  .svc-grid strong { font-size: 1.0625rem; color: var(--c-ink); }
  .svc-grid span { font-size: var(--t-small); color: var(--c-ink-muted); line-height: 1.5; }

  @media (max-width: 760px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
